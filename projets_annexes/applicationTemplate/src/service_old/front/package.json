    "./apiClient": "./employeeApiClient.js",
    "./apiClientTS": "./employeeApiClient.ts",
    "./reactAdmin": "./reactAdminConfig.js",
    "./reactAdminTS": "./reactAdminConfig.tsx",
    "./examples": "./examples.js",
    "./examplesTS": "./examples.ts",
    "./types": "./types.ts"
  },
  "files": [
    "employeeDataProvider.js",
    "employeeDataProvider.ts",
    "employeeApiClient.js",
    "employeeApiClient.ts",
    "reactAdminConfig.js",
    "reactAdminConfig.tsx",
    "examples.js",
    "examples.ts",
    "dataProvider.js",
    "dataProvider.ts",
    "types.ts",
    "tsconfig.json",
    "README.md"
