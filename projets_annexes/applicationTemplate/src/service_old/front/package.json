{
  "name": "employee-api-frontend",
  "version": "1.0.0",
  "description": "Front-end components for Employee API IBM i with TypeScript support",
  "main": "employeeDataProvider.js",
  "types": "types.ts",
  "scripts": {
    "test": "node test.js",
    "example": "node examples.js",
    "health-check": "node -e \"import('./employeeApiClient.js').then(m => m.employeeApi.testConnection().then(console.log))\"",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx"
  },
  "keywords": [
    "ibm-i",
    "rest-api",
    "react-admin",
    "data-provider",
    "employee",
    "rpg",
    "typescript",
    "archiapi"
  ],
  "dependencies": {
    "react-admin": "^4.0.0",
    "query-string": "^8.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "@mui/material": "^5.0.0",
    "@mui/icons-material": "^5.0.0"
  },
  "devDependencies": {
    "node-fetch": "^3.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0"
  },
  "type": "module",
  "exports": {
    "./dataProvider": "./employeeDataProvider.js",
