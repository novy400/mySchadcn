**free
/if defined(EMPROUTE_H_DEFINED)       
/eof                               
/endif                             
/define EMPROUTE_H_DEFINED  

// ------------------------------------------------------------------//
// Employee Route Interface Definitions                             //
// Mirror of emprest.rpgleinc for Route setup procedures            //
// ------------------------------------------------------------------//

// Route patterns
  dcl-ds emproute_patterns;
  *N varchar(100) inz('^/api/employees/?$');
  *N varchar(100) inz('^/api/employees/([0-9A-Za-z]+)$');
  *N varchar(100) inz('^/api/employees/health$');
  *N varchar(100) inz('^/api/employees/docs$');
  *N varchar(100) inz('^/api/employees/.*$');
  emproute_supportedPatterns varchar(100) dim(5) pos(1);
end-ds;

///
// Setup employee routes
//
// Configures all employee-related routes in the ILEastic configuration.
// Sets up CRUD endpoints compatible with React Admin data provider.
//
// @param **in/out** config  ILEastic configuration object
// @return void
// @tag Employee
// @tag Route
// @tag CMAGIC
///
dcl-pr employee_setupRoutes extproc(*dclcase);
  config likeds(il_config);
end-pr;

///
// Register complete employee API
//
// Registers all employee endpoints and routes in the ILEastic configuration.
// Includes logging and setup of all CRUD operations.
//
// @param **in/out** config  ILEastic configuration object
// @return void
// @tag Employee
// @tag Route
// @tag CMAGIC
///
dcl-pr employee_registerAPI extproc(*dclcase);
  config likeds(il_config);
end-pr;


