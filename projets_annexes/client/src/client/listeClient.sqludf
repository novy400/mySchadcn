CREATE OR REPLACE FUNCTION LSTCLIENT ()
RETURNS TABLE (
    codeEtablissement CHAR(3),
    numeroClient  NUMERIC(7, 0),
    nomClient       VARCHAR(38)
)
LANGUAGE RPGLE
PARAMETER STYLE DB2SQL
NOT DETERMINISTIC
READS SQL DATA
CALLED ON NULL INPUT
EXTERNAL NAME 'CLIENT(client_table)'
PROGRAM TYPE SUB
disallow parallel;
