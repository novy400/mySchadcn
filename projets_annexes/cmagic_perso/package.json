{
    "name": "cmagic",
    "description": "Please enter a brief description here",
    "version": "0.0.2",
    "publisher": "cmagic-publisher",
    "icon": "icon.png",
    "type": "module",
    "scripts": {
        "copy:templates": "cpr src/templates out/templates -o",
        "build": "npm-run-all langium:generate copy:templates build:ts",
        "build:ts": "tsc -b tsconfig.src.json && node esbuild.mjs",
        "watch": "concurrently -n tsc,esbuild -c blue,yellow \"tsc -b tsconfig.src.json --watch\" \"node esbuild.mjs --watch\"",
        "lint": "eslint src",
        "langium:generate": "langium generate",
        "langium:generate:production": "langium generate --mode=production",
        "langium:watch": "langium generate --watch",
        "vscode:prepublish": "npm run esbuild-base -- --minify && npm run lint",
        "esbuild-base": "esbuild ./src/extension/main.ts --bundle --outfile=out/main.js --external:vscode --format=cjs --platform=node",
        "build:web": "npm run build",
        "bundle": "vite build",
        "bundle:serve": "http-server ./dist --port 5175",
        "dev": "vite",
        "dev:debug": "vite --debug --force",
        "serve": "npm run dev",
        "pretest": "npm run langium:generate",
        "test": "vitest run"
    },
    "dependencies": {
        "@codingame/monaco-vscode-editor-service-override": "~3.2.3",
        "@codingame/monaco-vscode-keybindings-service-override": "~3.2.3",
        "chalk": "~5.3.0",
        "commander": "~11.0.0",
        "handlebars": "^4.7.8",
        "langium": "~3.5.0",
        "monaco-editor": "npm:@codingame/monaco-vscode-editor-api@~3.2.3",
        "monaco-editor-wrapper": "~4.0.2",
        "monaco-languageclient": "~8.1.1",
        "vscode-languageclient": "~9.0.1",
        "vscode-languageserver": "~9.0.1"
    },
    "devDependencies": {
        "@codingame/esbuild-import-meta-url-plugin": "~1.0.2",
        "@types/node": "^18.0.0",
        "@types/vscode": "~1.67.0",
        "@typescript-eslint/eslint-plugin": "~7.3.1",
        "@typescript-eslint/parser": "~7.3.1",
        "@vscode/vsce": "^3.6.0",
        "concurrently": "~8.2.1",
        "cpr": "^3.0.1",
        "esbuild": "^0.20.2",
        "eslint": "~8.57.0",
        "http-server": "~14.1.1",
        "langium-cli": "~3.5.0",
        "npm-run-all": "^4.1.5",
        "typescript": "~5.1.6",
        "vite": "~5.2.7",
        "vitest": "~1.4.0",
        "vscode": "npm:@codingame/monaco-vscode-api@~3.2.3"
    },
    "volta": {
        "node": "18.19.1",
        "npm": "10.2.4"
    },
    "displayName": "cmagic",
    "engines": {
        "vscode": "^1.67.0",
        "node": ">=18.0.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "commands": [
            {
                "command": "cmagic.generate",
                "title": "CMagic: Generate Code"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "cmagic.generate",
                    "when": "resourceLangId == cmagic",
                    "group": "navigation"
                }
            ],
            "explorer/context": [
                {
                    "command": "cmagic.generate",
                    "when": "resourceLangId == cmagic",
                    "group": "navigation"
                }
            ]
        },
        "languages": [
            {
                "id": "cmagic",
                "aliases": [
                    "cmagic",
                    "cmagic"
                ],
                "extensions": [
                    ".cmagic"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "cmagic",
                "scopeName": "source.cmagic",
                "path": "syntaxes/cmagic.tmLanguage.json"
            }
        ]
    },
    "activationEvents": [
        "onLanguage:cmagic"
    ],
    "main": "./out/extension/main.cjs",
    "bin": {
        "cmagic-cli": "./bin/cli.js"
    }
}
