// Fichier : src/customer/customerOrder.cmagic
// Description : Entité CustomerOrder pour MVP Sprint 1

// Structure réutilisable pour ligne de commande
struct OrderLine {
    productRef: String(10) required,
    quantity: Int required,
    unitPrice: Decimal(15,2) required,
    totalPrice: Decimal(15,2) required
}

// Énumération pour statut commande
enum OrderStatus {
    DRAFT,       // Brouillon
    CONFIRMED,   // Confirmée
    SHIPPED,     // Expédiée
    DELIVERED    // Livrée
}

// Entité principale CustomerOrder avec relation vers Customer
entity CustomerOrder {
    id: Int required,                                // Clé primaire auto-increment
    orderNumber: String(20) required unique,         // Numéro de commande unique
    customerId: Int required,                        // Référence vers Customer (FK)
    orderDate: Date required,                        // Date de commande
    deliveryDate: Date,                              // Date de livraison prévue
    status: OrderStatus default(DRAFT),              // Statut de la commande
    totalAmount: Decimal(15,2) default(0),          // Montant total
    taxAmount: Decimal(15,2) default(0),            // Montant TVA
    notes: String(500),                              // Notes/commentaires
    isUrgent: Boolean default(false)                 // Commande urgente
}

// Vue pour la liste des commandes
view orderList for CustomerOrder {
    id,
    orderNumber,
    customerId,
    orderDate,
    status,
    totalAmount
}
