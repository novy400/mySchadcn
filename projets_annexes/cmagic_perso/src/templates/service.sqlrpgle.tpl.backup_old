{{!-- src/templates/service.sqlrpgle.tpl - Version simplifiée pour debug --}}
**FREE
// ============================================
// {{name}} Service - Generated by CMagic v1.0 Sprint 2
// Source: {{@root.sourceFile}}
// ============================================

/if not defined({{toUpperCase name}}_SERVICE)
/define {{toUpperCase name}}_SERVICE

// Includes pour le service
/include '{{lowercase name}}.rpgleinc'
/include 'CMAGIC.rpgleinc'
/include 'GLOBAL.rpgleinc'

// ========================================
// API PUBLIQUE - PROCÉDURES EXPORTÉES
// ========================================

{{#each operations}}
{{#if (eq this 'CREATE')}}
DCL-PROC {{lowercase ../name}}_create EXPORT;
  DCL-PI *N IND;
    detail LIKEDS({{lowercase ../name}}_detail_t) CONST;
    id LIKEDS({{lowercase ../name}}_id_t);
    errors LIKEDS(GLOBAL_listError);
  END-PI;
  
  // Délégation vers implémentation locale
  RETURN {{lowercase ../name}}_create_local(detail : id : errors);
END-PROC;
{{/if}}

{{#if (eq this 'DISPLAY')}}
DCL-PROC {{lowercase ../name}}_display EXPORT;
  DCL-PI *N IND;
    id LIKEDS({{lowercase ../name}}_id_t) CONST;
    errors LIKEDS(GLOBAL_listError);
  END-PI;
  
  // Délégation vers implémentation locale
  RETURN {{lowercase ../name}}_display_local(id : errors);
END-PROC;
{{/if}}

{{#if (eq this 'CHANGE')}}
DCL-PROC {{lowercase ../name}}_change EXPORT;
  DCL-PI *N IND;
    id LIKEDS({{lowercase ../name}}_id_t) CONST;
    detail LIKEDS({{lowercase ../name}}_detail_t) CONST;
    errors LIKEDS(GLOBAL_listError);
  END-PI;
  
  // Délégation vers implémentation locale
  RETURN {{lowercase ../name}}_change_local(id : detail : errors);
END-PROC;
{{/if}}

{{#if (eq this 'DELETE')}}
DCL-PROC {{lowercase ../name}}_delete EXPORT;
  DCL-PI *N IND;
    id LIKEDS({{lowercase ../name}}_id_t) CONST;
    errors LIKEDS(GLOBAL_listError);
  END-PI;
  
  // Délégation vers implémentation locale
  RETURN {{lowercase ../name}}_delete_local(id : errors);
END-PROC;
{{/if}}

{{#if (eq this 'SEARCH')}}
DCL-PROC {{lowercase ../name}}_search EXPORT;
  DCL-PI *N IND;
    context LIKEDS(CMAGIC_context) CONST;
    totalCount LIKE(CMAGIC_totalCount);
    items POINTER;
    errors LIKEDS(GLOBAL_listError);
  END-PI;
  
  // Délégation vers implémentation locale
  RETURN {{lowercase ../name}}_search_local(context : totalCount : items : errors);
END-PROC;
{{/if}}
{{/each}}

// ========================================
// ZONE MANUELLE - PRÉSERVÉE
// ========================================
// [CMAGIC:MANUAL_START]

{{#each operations}}
{{#if (eq this 'CREATE')}}
DCL-PROC {{lowercase ../name}}_create_local;
  DCL-PI *N IND;
    detail LIKEDS({{lowercase ../name}}_detail_t) CONST;
    id LIKEDS({{lowercase ../name}}_id_t);
    errors LIKEDS(GLOBAL_listError);
  END-PI;
  
  // TODO: Implémentation locale à personnaliser
  CLEAR id;
  CLEAR errors;
  RETURN *ON;
END-PROC;
{{/if}}

{{#if (eq this 'DISPLAY')}}
DCL-PROC {{lowercase ../name}}_display_local;
  DCL-PI *N IND;
    id LIKEDS({{lowercase ../name}}_id_t) CONST;
    errors LIKEDS(GLOBAL_listError);
  END-PI;
  
  // TODO: Implémentation locale à personnaliser
  CLEAR errors;
  RETURN *ON;
END-PROC;
{{/if}}

{{#if (eq this 'CHANGE')}}
DCL-PROC {{lowercase ../name}}_change_local;
  DCL-PI *N IND;
    id LIKEDS({{lowercase ../name}}_id_t) CONST;
    detail LIKEDS({{lowercase ../name}}_detail_t) CONST;
    errors LIKEDS(GLOBAL_listError);
  END-PI;
  
  // TODO: Implémentation locale à personnaliser
  CLEAR errors;
  RETURN *ON;
END-PROC;
{{/if}}

{{#if (eq this 'DELETE')}}
DCL-PROC {{lowercase ../name}}_delete_local;
  DCL-PI *N IND;
    id LIKEDS({{lowercase ../name}}_id_t) CONST;
    errors LIKEDS(GLOBAL_listError);
  END-PI;
  
  // TODO: Implémentation locale à personnaliser
  CLEAR errors;
  RETURN *ON;
END-PROC;
{{/if}}

{{#if (eq this 'SEARCH')}}
DCL-PROC {{lowercase ../name}}_search_local;
  DCL-PI *N IND;
    context LIKEDS(CMAGIC_context) CONST;
    totalCount LIKE(CMAGIC_totalCount);
    items POINTER;
    errors LIKEDS(GLOBAL_listError);
  END-PI;
  
  // TODO: Implémentation locale à personnaliser
  CLEAR totalCount;
  CLEAR errors;
  items = *NULL;
  RETURN *ON;
END-PROC;
{{/if}}
{{/each}}

// [CMAGIC:MANUAL_END]

/endif
