// Implémentation interne - Validation
dcl-proc {{lowercase this.name}}_isValid_local;
  dcl-pi *N ind;
    pAction like(GLOBAL_codeAction) Const;
    pBeforeDetail likeds({{lowercase this.name}}_detail_t) Const;
    pAfterDetail likeds({{lowercase this.name}}_detail_t) Const;
    pErrors likeDS(GLOBAL_listError);
  end-pi;
    dcl-s ErrorHappened ind;
    dcl-ds lError likeds(errorItem) inz;
  
    // initialisation
    clear pErrors;
  
    // TODO: Implémenter les validations métier
    
    // Validations communes
{{#each this.fields}}
{{#if this.required}}
    // Validation champ requis: {{this.name}}
    select;
      when pAction = {{lowercase ../this.name}}_listeAction.creation or 
           pAction = {{lowercase ../this.name}}_listeAction.modification;
        // TODO: Ajouter validation pour {{this.name}}
    endsl;
{{/if}}
{{/each}}
  
    // Si des erreurs, retourner *off
    if pErrors.count > 0;
      return *off;
    endif;
    
    return *on;
  
  on-exit ErrorHappened;
    if ErrorHappened;
      return *off;
    endif;
end-proc;

// Implémentation interne - Affichage
dcl-proc {{lowercase this.name}}_display_local;
  dcl-pi *N ind;
    pId likeDS({{lowercase this.name}}_id_t) const;
    pErrors likeDS(GLOBAL_listError);
  end-pi;
    dcl-s ErrorHappened ind;
    dcl-ds lDetail likeds({{lowercase this.name}}_detail_t);
    dcl-ds lErrors likeDS(GLOBAL_listError);
  
    // initialisation
    clear pErrors;
  
    // Récupérer les détails
    if not {{lowercase this.name}}_getByID_local(pId : lDetail : lErrors);
      pErrors = lErrors;
      return *off;
    endif;
    
    // TODO: Implémenter l'affichage (écran, rapport, etc.)
    
    return *on;
  
  on-exit ErrorHappened;
    if ErrorHappened;
      return *off;
    endif;
end-proc;

// [CMAGIC:MANUAL_END]
///
DCL-PROC {{lowercase ../name}}_getByID EXPORT;
  DCL-PI *N IND;
    id LIKEDS({{lowercase ../name}}_id_t) CONST;
    detail LIKEDS({{lowercase ../name}}_detail_t);
    errors LIKEDS(GLOBAL_listError);
  END-PI;
  
  // Variables locales
  DCL-S ErrorHappened IND;
  DCL-DS lErrors LIKEDS(GLOBAL_listError);
  
  // Initialisation
  CLEAR detail;
  CLEAR errors;
  
  // [CMAGIC:MANUAL_START:{{lowercase ../name}}_display_validation]
  // Zone manuelle pour validation paramètres DISPLAY
  // Exemple: vérification ID valide, droits accès, etc.
  // [CMAGIC:MANUAL_END:{{lowercase ../name}}_display_validation]
  
  // Traitement
  IF NOT {{lowercase ../name}}_getByID_local(id : detail : lErrors);
    errors = lErrors;
    RETURN *OFF;
  ENDIF;
  
  // Finalisation
  RETURN *ON;
  
  ON-EXIT ErrorHappened;
    IF ErrorHappened;
      RETURN *OFF;
    ENDIF;
END-PROC;
{{/if}}

{{#if (eq this 'CHANGE')}}
///
// Mise à jour {{../name}} existant
//
// @param **in** id {{../name}} ID
// @param **in** detail {{../name}} detail
// @param **out** errors list of errors
// @return *on if ok, *off if error
// @tag {{../name}}
// @tag CMAGIC
///
DCL-PROC {{lowercase ../name}}_change EXPORT;
  DCL-PI *N IND;
    id LIKEDS({{lowercase ../name}}_id_t) CONST;
    detail LIKEDS({{lowercase ../name}}_detail_t) CONST;
    errors LIKEDS(GLOBAL_listError);
  END-PI;
  
  // Variables locales
  DCL-S ErrorHappened IND;
  DCL-DS lDetailBefore LIKEDS({{lowercase ../name}}_detail_t);
  DCL-DS lDetailAfter LIKEDS({{lowercase ../name}}_detail_t);
  DCL-DS lErrors LIKEDS(GLOBAL_listError);
  
  // Initialisation
  CLEAR errors;
  
  // [CMAGIC:MANUAL_START:{{lowercase ../name}}_change_validation]
  // Zone manuelle pour validation métier spécifique CHANGE
  // Exemple: vérification version, verrouillage, etc.
  // [CMAGIC:MANUAL_END:{{lowercase ../name}}_change_validation]
  
  // Traitement de la modification
  // Contrôle de l'action
  CLEAR lDetailBefore;
  CLEAR lDetailAfter;
  CLEAR lErrors;
  
  // Récupération de l'état avant modification
  IF NOT {{lowercase ../name}}_getByID_local(id : lDetailBefore : lErrors);
    errors = lErrors;
    RETURN *OFF;
  ENDIF;
  
  lDetailAfter = detail;
  
  IF NOT {{lowercase ../name}}_isValid({{lowercase ../name}}_listeAction.modification
         : lDetailBefore : lDetailAfter : lErrors);
    errors = lErrors;
    RETURN *OFF;
  ENDIF;
  
  // Modification métier
  CLEAR lErrors;
  IF NOT {{lowercase ../name}}_change_local(id : detail : lErrors);
    errors = lErrors;
    RETURN *OFF;
  ENDIF;
  
  // Finalisation
  RETURN *ON;
  
  ON-EXIT ErrorHappened;
    IF ErrorHappened;
      RETURN *OFF;
    ENDIF;
END-PROC;
{{/if}}

{{#if (eq this 'DELETE')}}
///
// Suppression {{../name}}
//
// @param **in** id {{../name}} ID
// @param **out** errors list of errors
// @return *on if ok, *off if error
// @tag {{../name}}
// @tag CMAGIC
///
DCL-PROC {{lowercase ../name}}_delete EXPORT;
  DCL-PI *N IND;
    id LIKEDS({{lowercase ../name}}_id_t) CONST;
    errors LIKEDS(GLOBAL_listError);
  END-PI;
  
  // Variables locales
  DCL-S ErrorHappened IND;
  DCL-DS lDetailBefore LIKEDS({{lowercase ../name}}_detail_t);
  DCL-DS lDetailAfter LIKEDS({{lowercase ../name}}_detail_t);
  DCL-DS lErrors LIKEDS(GLOBAL_listError);
  
  // Initialisation
  CLEAR errors;
  
  // [CMAGIC:MANUAL_START:{{lowercase ../name}}_delete_validation]
  // Zone manuelle pour validation métier spécifique DELETE
  // Exemple: vérification dépendances, cascade, etc.
  // [CMAGIC:MANUAL_END:{{lowercase ../name}}_delete_validation]
  
  // Traitement de la suppression
  // Contrôle de l'action
  CLEAR lDetailBefore;
  CLEAR lDetailAfter;
  CLEAR lErrors;
  
  // Récupération de l'état avant suppression
  IF NOT {{lowercase ../name}}_getByID_local(id : lDetailBefore : lErrors);
    errors = lErrors;
    RETURN *OFF;
  ENDIF;
  
  CLEAR lDetailAfter;
  
  IF NOT {{lowercase ../name}}_isValid({{lowercase ../name}}_listeAction.suppression
         : lDetailBefore : lDetailAfter : lErrors);
    errors = lErrors;
    RETURN *OFF;
  ENDIF;
  
  // Suppression métier
  CLEAR lErrors;
  IF NOT {{lowercase ../name}}_delete_local(id : lErrors);
    errors = lErrors;
    RETURN *OFF;
  ENDIF;
  
  // Finalisation
  RETURN *ON;
  
  ON-EXIT ErrorHappened;
    IF ErrorHappened;
      RETURN *OFF;
    ENDIF;
END-PROC;
{{/if}}

{{#if (eq this 'SEARCH')}}
///
// Recherche {{../name}}
//
// @param **in** criteria {{../name}} search criteria
// @param **out** resultList list of results
// @param **out** errors list of errors
// @return *on if ok, *off if error
// @tag {{../name}}
// @tag CMAGIC
///
DCL-PROC {{lowercase ../name}}_search EXPORT;
  DCL-PI *N IND;
    criteria LIKEDS({{lowercase ../name}}_search_t) CONST;
    resultList LIKEDS(GLOBAL_List);
    errors LIKEDS(GLOBAL_listError);
  END-PI;
  
  // Variables locales
  DCL-S ErrorHappened IND;
  DCL-DS lErrors LIKEDS(GLOBAL_listError);
  
  // Initialisation
  CLEAR errors;
  
  // [CMAGIC:MANUAL_START:{{lowercase ../name}}_search_validation]
  // Zone manuelle pour validation critères SEARCH
  // Exemple: vérification critères, limites, etc.
  // [CMAGIC:MANUAL_END:{{lowercase ../name}}_search_validation]
  
  // Traitement
  IF NOT {{lowercase ../name}}_search_local(criteria : resultList : lErrors);
    errors = lErrors;
    RETURN *OFF;
  ENDIF;
  
  // Finalisation
  RETURN *ON;
  
  ON-EXIT ErrorHappened;
    IF ErrorHappened;
      RETURN *OFF;
    ENDIF;
END-PROC;
{{/if}}
{{/each}}

// ========================================
// PROCÉDURES DE VALIDATION
// ========================================

DCL-PROC {{lowercase name}}_isValid EXPORT;
  DCL-PI *N IND;
    action LIKE(GLOBAL_codeAction) CONST; // in {{lowercase name}}_listeAction
    beforeDetail LIKEDS({{lowercase name}}_detail_t) CONST;
    afterDetail LIKEDS({{lowercase name}}_detail_t) CONST;
    errors LIKEDS(GLOBAL_listError);
  END-PI;
  
  // Variables locales
  DCL-S ErrorHappened IND;
  DCL-DS lErrors LIKEDS(GLOBAL_listError);
  
  // Initialisation
  CLEAR lErrors;
  
  // [CMAGIC:MANUAL_START:{{lowercase name}}_isValid_implementation]
  // Zone manuelle pour validation métier personnalisée
  // Exemple: règles business spécifiques selon l'action
  // [CMAGIC:MANUAL_END:{{lowercase name}}_isValid_implementation]
  
  // Traitement
  IF NOT {{lowercase name}}_isValid_local(action : beforeDetail : afterDetail : lErrors);
    errors = lErrors;
    RETURN *OFF;
  ENDIF;
  
  // Finalisation
  RETURN *ON;
  
  ON-EXIT ErrorHappened;
    IF ErrorHappened;
      RETURN *OFF;
    ENDIF;
END-PROC;

// ========================================
// IMPLÉMENTATION INTERNE
// ========================================

{{#each operations}}
{{#if (eq this 'CREATE')}}
// ----------------------------------------
// CREATE Implementation - Internal
// ----------------------------------------
DCL-PROC {{lowercase ../name}}_create_local;
  DCL-PI *N IND;
    detail LIKEDS({{lowercase ../name}}_detail_t) CONST;
    id LIKEDS({{lowercase ../name}}_id_t);
    errors LIKEDS(GLOBAL_listError);
  END-PI;
  
  DCL-S lOK IND INZ(*OFF);
  
  // [CMAGIC:MANUAL_START:{{lowercase ../name}}_create_implementation]
  // TODO: Implémentation CREATE personnalisée
  //
  // Exemple d'implémentation :
  // EXEC SQL
  //   INSERT INTO {{toUpperCase ../name}}P (
  //     NAME, EMAIL, CREATED_AT, UPDATED_AT
  //   ) VALUES (
