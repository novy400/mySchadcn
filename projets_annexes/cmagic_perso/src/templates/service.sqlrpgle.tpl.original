{{#each operations}}
{{#if (eq this 'CREATE')}}
// Implémentation interne - Création
dcl-proc {{lowercase ../name}}_create_local;
  dcl-pi *N ind;
    pDetail likeds({{lowercase ../name}}_detail_t) const;
    pId likeDS({{lowercase ../name}}_id_t);
    pErrors likeDS(GLOBAL_listError);
  end-pi;
    dcl-s ErrorHappened ind;
    dcl-ds lDetail likeDs({{lowercase ../name}}_t);
    dcl-ds lError likeds(errorItem) inz;
    dcl-s lNewId like(pId.id);
  
    // initialisation
    clear pId;
    clear pErrors;
    clear lDetail;
    lDetail = pDetail.detail;
  
    // TODO: Implémenter la logique de création en base
    monitor;
      // Exemple d'insertion SQL
      // exec sql INSERT INTO {{toUpperCase ../name}} ...
      
      pId.id = 1; // placeholder - utiliser IDENTITY_VAL_LOCAL() dans vrai code
      return *on;
      
    on-error;
      lError.message = 'Erreur lors de la création en base';
      lError.field = '';
      GLOBAL_addError(pErrors : lError);
      return *off;
    endmon;
  
  on-exit ErrorHappened;
    if ErrorHappened;
      return *off;
    endif;
end-proc;
{{/if}}

{{#if (eq this 'DISPLAY')}}
// Implémentation interne - Récupération par ID
dcl-proc {{lowercase ../name}}_getByID_local;
  dcl-pi *N ind;
    pId likeDS({{lowercase ../name}}_id_t) const;
    pDetail likeds({{lowercase ../name}}_detail_t);
    pErrors likeDS(GLOBAL_listError);
  end-pi;
    dcl-s ErrorHappened ind;
