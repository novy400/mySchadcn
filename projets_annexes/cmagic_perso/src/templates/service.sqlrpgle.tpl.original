    dcl-ds lError likeds(errorItem) inz;
  
    // initialisation
    clear pDetail;
    clear pErrors;
    clear lDetail;
  
    // TODO: Implémenter la logique de récupération
    monitor;
      // Exemple de SELECT SQL
      // exec sql SELECT * FROM {{toUpperCase ../name}} WHERE ID = :pId.id INTO :lDetail;
      
      if sqlcode = 100;
        lError.message = '{{../name}} non trouvé';
        lError.field = 'id';
        GLOBAL_addError(pErrors : lError);
        return *off;
      endif;
      
      pDetail.detail = lDetail;
      return *on;
      
    on-error;
      lError.message = 'Erreur lors de la récupération';
      lError.field = '';
      GLOBAL_addError(pErrors : lError);
      return *off;
    endmon;
  
  on-exit ErrorHappened;
    if ErrorHappened;
      return *off;
    endif;
end-proc;
{{/if}}

