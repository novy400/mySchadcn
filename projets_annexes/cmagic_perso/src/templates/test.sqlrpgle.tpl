/include qinclude,TESTCASE 
/include '/usr/local/include/{{lowercase this.name}}.rpgleinc'

dcl-pr QCMDEXC extpgm;
    command char(32767) const;
    length packed(15: 5) const;
end-pr;
dcl-s gCmd varchar(256);

// ========================================
// Test Setup/Teardown
// ========================================
dcl-proc setUpSuite export;
    dcl-pi *N; 
    end-pi;
    // [CMAGIC:MANUAL_START:setUpSuite]
    // Setup global pour tous les tests
    // [CMAGIC:MANUAL_END:setUpSuite]
end-proc;

dcl-proc setUp export;
    dcl-pi *N; 
    end-pi;
    dcl-s lCmd like(gCmd);
    
    // [CMAGIC:MANUAL_START:setUp]
    // Setup avant chaque test
    // [CMAGIC:MANUAL_END:setUp]
end-proc;

dcl-proc tearDown export;
    dcl-pi *N; 
    end-pi;
    
    // [CMAGIC:MANUAL_START:tearDown]
    // Cleanup après chaque test
    // [CMAGIC:MANUAL_END:tearDown]
end-proc;

dcl-proc tearDownSuite export;
    dcl-pi *N; 
    end-pi;
    // [CMAGIC:MANUAL_START:tearDownSuite]
    // Cleanup global après tous les tests
    // [CMAGIC:MANUAL_END:tearDownSuite]
end-proc;

