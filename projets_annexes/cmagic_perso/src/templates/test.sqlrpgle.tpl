{{#each operations}}
{{#if (eq this 'CREATE')}}
// Test création {{../name}}
dcl-proc test_{{lowercase ../name}}_create_success export;
    dcl-pi *N; 
    end-pi;
    dcl-s ErrorHappened ind;
    dcl-ds lDetail likeds({{lowercase ../name}}_detail_t) inz;
    dcl-ds lId likeds({{lowercase ../name}}_id_t) inz;
    dcl-ds lErrors likeds(GLOBAL_listError) inz;
    dcl-s lOK ind;
    
    // [CMAGIC:MANUAL_START:test_{{lowercase ../name}}_create_setup]
    // Préparer les données de test pour création
    // [CMAGIC:MANUAL_END:test_{{lowercase ../name}}_create_setup]
    
    // Test création
    lOK = {{lowercase ../name}}_create(lDetail : lId : lErrors);
    
    // Vérifications
    assert(lOK : 'Creation should succeed');
    assert(lId.id > 0 : 'ID should be generated');
    
    // [CMAGIC:MANUAL_START:test_{{lowercase ../name}}_create_cleanup]
    // Cleanup spécifique au test
    // [CMAGIC:MANUAL_END:test_{{lowercase ../name}}_create_cleanup]
    
  on-exit ErrorHappened;
    if ErrorHappened;
      fail('Unexpected error in {{lowercase ../name}}_create test');
    endif;
end-proc;

dcl-proc test_{{lowercase ../name}}_create_validation_error export;
    dcl-pi *N; 
    end-pi;
    dcl-s ErrorHappened ind;
    dcl-ds lDetail likeds({{lowercase ../name}}_detail_t) inz;
    dcl-ds lId likeds({{lowercase ../name}}_id_t) inz;
    dcl-ds lErrors likeds(GLOBAL_listError) inz;
    dcl-s lOK ind;
    
    // [CMAGIC:MANUAL_START:test_{{lowercase ../name}}_create_invalid_setup]
    // Préparer des données invalides pour test validation
    // [CMAGIC:MANUAL_END:test_{{lowercase ../name}}_create_invalid_setup]
    
    // Test création avec données invalides
    lOK = {{lowercase ../name}}_create(lDetail : lId : lErrors);
    
    // Vérifications
    assert(not lOK : 'Creation should fail with invalid data');
    assert(lErrors.count > 0 : 'Should have validation errors');
    
  on-exit ErrorHappened;
    if ErrorHappened;
      fail('Unexpected error in {{lowercase ../name}}_create validation test');
    endif;
end-proc;
{{/if}}

{{#if (eq this 'DISPLAY')}}
// Test récupération {{../name}} par ID
dcl-proc test_{{lowercase ../name}}_getByID_success export;
    dcl-pi *N; 
    end-pi;
    dcl-s ErrorHappened ind;
    dcl-ds lId likeds({{lowercase ../name}}_id_t) inz;
    dcl-ds lDetail likeds({{lowercase ../name}}_detail_t) inz;
    dcl-ds lErrors likeds(GLOBAL_listError) inz;
    dcl-s lOK ind;
    
    // [CMAGIC:MANUAL_START:test_{{lowercase ../name}}_getByID_setup]
    // Préparer un ID existant pour le test
    // [CMAGIC:MANUAL_END:test_{{lowercase ../name}}_getByID_setup]
    
    // Test récupération
    lOK = {{lowercase ../name}}_getByID(lId : lDetail : lErrors);
    
    // Vérifications
    assert(lOK : 'GetByID should succeed');
    assert(lDetail.detail.id = lId.id : 'Retrieved ID should match');
    
  on-exit ErrorHappened;
    if ErrorHappened;
      fail('Unexpected error in {{lowercase ../name}}_getByID test');
    endif;
end-proc;

