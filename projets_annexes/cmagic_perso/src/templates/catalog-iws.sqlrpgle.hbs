**free
{{! IBM Integrated Web Services read adapter generated from CatalogSpec. }}
{{#*inline "handleUnexpectedIwsError"}}
    if lAbended;
      httpStatus = HTTPREST_SERVERERROR;
      if errors_LENGTH = 0;
        errors_LENGTH = 1;
        errors(1).nomZone = '{{procedure}}';
        errors(1).code = 'RNX9001';
        errors(1).text =
          'Unexpected error in {{procedure}}';
        errors(1).textUser = errors(1).text;
      endif;
    endif;
{{/inline}}
// Generated from CatalogSpec with catalog-iws.sqlrpgle.hbs. Do not edit.
ctl-opt nomain
        option(*nodebugio:*srcstmt:*nounref)
        alwnull(*usrctl)
        pgminfo(*pcml:*module:*dclcase)
        datfmt(*iso)
        bnddir('QC2LE':'{{readObjectName}}':'CKOOL':'NOXDB');

/include '{{interfaces.iws}}'
/include '{{interfaces.read}}'
/include 'ciws.rpgleinc'
/include 'llist/llist_h.rpgle'

{{#if hasList}}
dcl-proc {{procedures.getListIws}} export;
  dcl-pi *n;
    items_LENGTH int(10);
    items likeDS({{itemType}}) dim(HTTPREST_MAX_ITEMS);
    totalCount like(CMAGIC_totalCount);
    errors_LENGTH int(10);
    errors likeDS(errorItem) dim(HTTPREST_MAX_ERRORS);
    httpStatus like(HTTPREST_httpStatus);
    httpHeaders like(HTTPREST_httpHeader) dim(HTTPREST_nbHeaders);
  end-pi;
  dcl-s lAbended ind inz(*off);
  dcl-ds lContext likeDS(CMAGIC_context) inz;
  dcl-ds lErrors likeDS(GLOBAL_listError) inz;
  dcl-ds lSupportedFields likeDS(CMAGIC_supportedFields) inz;
  dcl-s lItems pointer inz(*null);

  clear items_LENGTH;
  clear items;
  clear totalCount;
  clear errors_LENGTH;
  clear errors;
  clear httpHeaders;
  httpStatus = HTTPREST_OK;

  if not {{procedures.getSupportedFields}}(
    lSupportedFields : lErrors);
    httpStatus = HTTPREST_SERVERERROR;
    errors_LENGTH = CIWS_setErrors(lErrors : errors);
    return;
  endif;

  if not CIWS_initRestRequest(
    lSupportedFields : lContext : lErrors);
    httpStatus = HTTPREST_BADREQUEST;
    errors_LENGTH = CIWS_setErrors(lErrors : errors);
    return;
  endif;

  if not {{procedures.search}}(
    lContext : totalCount : lItems : lErrors);
    if lErrors.listError(1).nomZone = 'sql';
      httpStatus = HTTPREST_SERVERERROR;
    else;
      httpStatus = HTTPREST_BADREQUEST;
    endif;
    errors_LENGTH = CIWS_setErrors(lErrors : errors);
    return;
  endif;

  {{procedures.copyItems}}(lItems : items_LENGTH : items);
  CIWS_addCollectionHeaders(totalCount : httpHeaders);

  on-exit lAbended;
    if lItems <> *null;
      list_dispose(lItems);
    endif;
{{> handleUnexpectedIwsError procedure=procedures.getListIws}}
end-proc;

dcl-proc {{procedures.copyItems}};
  dcl-pi *n;
    pList pointer value;
    pItemsLength int(10);
    pItems likeDS({{itemType}}) dim(HTTPREST_MAX_ITEMS);
  end-pi;
  dcl-s lItemPointer pointer inz(*null);
  dcl-ds lSource likeDS({{entityName}}_item_t)
    based(lItemPointer);

  clear pItemsLength;
  clear pItems;
  if pList = *null;
    return;
  endif;

  lItemPointer = list_iterate(pList);
  dow lItemPointer <> *null
    and pItemsLength < HTTPREST_MAX_ITEMS;
    pItemsLength += 1;
    eval-corr pItems(pItemsLength) = lSource;
    lItemPointer = list_iterate(pList);
  enddo;
end-proc;
{{/if}}
{{#if hasCreate}}
dcl-proc {{procedures.createIws}} export;
  dcl-pi *n;
    input likeDS({{detailType}}) const;
    item likeDS({{detailType}});
    errors_LENGTH int(10);
    errors likeDS(errorItem) dim(HTTPREST_MAX_ERRORS);
    httpStatus like(HTTPREST_httpStatus);
    httpHeaders like(HTTPREST_httpHeader) dim(HTTPREST_nbHeaders);
  end-pi;
  dcl-s lAbended ind inz(*off);
  dcl-s lId {{id.rpgType}} inz;
  dcl-ds lDetail likeDS({{entityName}}_detail_t) inz;
  dcl-ds lCreatedDetail likeDS({{entityName}}_detail_t) inz;
  dcl-ds lErrors likeDS(GLOBAL_listError) inz;

  clear item;
  clear errors_LENGTH;
  clear errors;
  clear httpHeaders;
  httpStatus = HTTPREST_CREATED;
  eval-corr lDetail = input;

  if not {{procedures.create}}(lDetail : lId : lErrors);
    select;
      when lErrors.listError(1).nomZone = 'conflict';
        httpStatus = HTTPREST_CONFLICT;
      when lErrors.listError(1).nomZone = 'sql';
        httpStatus = HTTPREST_SERVERERROR;
      other;
        httpStatus = HTTPREST_BADREQUEST;
    endsl;
    errors_LENGTH = CIWS_setErrors(lErrors : errors);
    return;
  endif;

  clear lErrors;
  if not {{procedures.get}}(lId : lCreatedDetail : lErrors);
    httpStatus = HTTPREST_SERVERERROR;
    errors_LENGTH = CIWS_setErrors(lErrors : errors);
    return;
  endif;
  eval-corr item = lCreatedDetail;
  httpStatus = HTTPREST_CREATED;

  on-exit lAbended;
{{> handleUnexpectedIwsError procedure=procedures.createIws}}
end-proc;
{{/if}}
{{#if hasUpdate}}
dcl-proc {{procedures.updateIws}} export;
  dcl-pi *n;
    id {{id.rpgType}} const;
    input likeDS({{detailType}}) const;
    item likeDS({{detailType}});
    errors_LENGTH int(10);
    errors likeDS(errorItem) dim(HTTPREST_MAX_ERRORS);
    httpStatus like(HTTPREST_httpStatus);
    httpHeaders like(HTTPREST_httpHeader) dim(HTTPREST_nbHeaders);
  end-pi;
  dcl-s lAbended ind inz(*off);
  dcl-ds lDetail likeDS({{entityName}}_detail_t) inz;
  dcl-ds lUpdatedDetail likeDS({{entityName}}_detail_t) inz;
  dcl-ds lErrors likeDS(GLOBAL_listError) inz;

  clear item;
  clear errors_LENGTH;
  clear errors;
  clear httpHeaders;
  httpStatus = HTTPREST_OK;
  eval-corr lDetail = input;

  if not {{procedures.update}}(id : lDetail : lErrors);
    select;
      when lErrors.listError(1).code = 'CAT0001'
        and lErrors.listError(1).nomZone = 'id';
        httpStatus = HTTPREST_NOTFOUND;
      when lErrors.listError(1).nomZone = 'conflict';
        httpStatus = HTTPREST_CONFLICT;
      when lErrors.listError(1).nomZone = 'sql';
        httpStatus = HTTPREST_SERVERERROR;
      other;
        httpStatus = HTTPREST_BADREQUEST;
    endsl;
    errors_LENGTH = CIWS_setErrors(lErrors : errors);
    return;
  endif;

  clear lErrors;
  if not {{procedures.get}}(id : lUpdatedDetail : lErrors);
    httpStatus = HTTPREST_SERVERERROR;
    errors_LENGTH = CIWS_setErrors(lErrors : errors);
    return;
  endif;
  eval-corr item = lUpdatedDetail;
  httpStatus = HTTPREST_OK;

  on-exit lAbended;
{{> handleUnexpectedIwsError procedure=procedures.updateIws}}
end-proc;
{{/if}}
{{#if hasDelete}}
dcl-proc {{procedures.deleteIws}} export;
  dcl-pi *n;
    id {{id.rpgType}} const;
    errors_LENGTH int(10);
    errors likeDS(errorItem) dim(HTTPREST_MAX_ERRORS);
    httpStatus like(HTTPREST_httpStatus);
    httpHeaders like(HTTPREST_httpHeader) dim(HTTPREST_nbHeaders);
  end-pi;
  dcl-s lAbended ind inz(*off);
  dcl-ds lErrors likeDS(GLOBAL_listError) inz;

  clear errors_LENGTH;
  clear errors;
  clear httpHeaders;
  httpStatus = HTTPREST_NOCONTENT;

  if not {{procedures.delete}}(id : lErrors);
    select;
      when lErrors.listError(1).code = 'CAT0001'
        and lErrors.listError(1).nomZone = 'id';
        httpStatus = HTTPREST_NOTFOUND;
      when lErrors.listError(1).nomZone = 'conflict';
        httpStatus = HTTPREST_CONFLICT;
      when lErrors.listError(1).nomZone = 'sql';
        httpStatus = HTTPREST_SERVERERROR;
      other;
        httpStatus = HTTPREST_BADREQUEST;
    endsl;
    errors_LENGTH = CIWS_setErrors(lErrors : errors);
    return;
  endif;

  httpStatus = HTTPREST_NOCONTENT;

  on-exit lAbended;
{{> handleUnexpectedIwsError procedure=procedures.deleteIws}}
end-proc;
{{/if}}
{{#if hasGet}}
dcl-proc {{procedures.getOneIws}} export;
  dcl-pi *n;
    id {{id.rpgType}} const;
    item likeDS({{detailType}});
    errors_LENGTH int(10);
    errors likeDS(errorItem) dim(HTTPREST_MAX_ERRORS);
    httpStatus like(HTTPREST_httpStatus);
    httpHeaders like(HTTPREST_httpHeader) dim(HTTPREST_nbHeaders);
  end-pi;
  dcl-s lAbended ind inz(*off);
  dcl-ds lDetail likeDS({{entityName}}_detail_t) inz;
  dcl-ds lErrors likeDS(GLOBAL_listError) inz;

  clear item;
  clear errors_LENGTH;
  clear errors;
  clear httpHeaders;
  httpStatus = HTTPREST_OK;

  if not {{procedures.get}}(id : lDetail : lErrors);
    if lErrors.listError(1).nomZone = 'id';
      httpStatus = HTTPREST_NOTFOUND;
    else;
      httpStatus = HTTPREST_SERVERERROR;
    endif;
    errors_LENGTH = CIWS_setErrors(lErrors : errors);
    return;
  endif;

  eval-corr item = lDetail;

  on-exit lAbended;
{{> handleUnexpectedIwsError procedure=procedures.getOneIws}}
end-proc;
