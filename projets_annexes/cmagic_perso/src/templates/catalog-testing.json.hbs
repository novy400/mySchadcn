{
  "rpgunit": {
    "rucrtrpg": {
      "tgtCcsid": "*JOB",
      "dbgView": "*SOURCE",
      "rpgPpOpt": "*LVL2",
      "cOption": [
        "*EVENTF"
      ]{{#if bindServicePrograms}},
      "bndSrvPgm": [
{{#each bindServicePrograms}}
        "{{this}}"{{#unless @last}},{{/unless}}
{{/each}}
      ]{{/if}}
    }
  },
  "codecov": {
    "module": [
{{#each codecovModules}}
      "{{this}}"{{#unless @last}},{{/unless}}
{{/each}}
    ]
  }
}
