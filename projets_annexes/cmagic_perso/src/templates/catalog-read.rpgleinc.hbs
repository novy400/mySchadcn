**free
{{! Public RPG read interface generated from CatalogSpec. }}
/if defined({{includeGuard}})
/eof
/endif
/define {{includeGuard}}
/include '{{runtimeIncludes.cmagic}}'
/include '{{runtimeIncludes.global}}'

{{#if procedures.hasList}}
dcl-ds {{entityName}}_item_t qualified template;
{{#each itemFields}}
  {{rpgName}} {{rpgType}};
{{/each}}
end-ds;

dcl-pr {{procedureSignatures.getSupportedFields.name}} {{procedureSignatures.getSupportedFields.returnType}} extproc(*dclcase);
{{#each procedureSignatures.getSupportedFields.parameters}}
  {{name}} {{type}}{{#if isConst}} const{{/if}};
{{/each}}
end-pr;

dcl-pr {{procedureSignatures.search.name}} {{procedureSignatures.search.returnType}} extproc(*dclcase);
{{#each procedureSignatures.search.parameters}}
  {{name}} {{type}}{{#if isConst}} const{{/if}};
{{/each}}
end-pr;
{{/if}}
{{#if hasDetail}}
dcl-ds {{entityName}}_detail_t qualified template;
{{#each detailFields}}
  {{rpgName}} {{rpgType}};
{{/each}}
end-ds;
{{/if}}

{{#if procedures.hasGet}}
dcl-pr {{procedureSignatures.get.name}} {{procedureSignatures.get.returnType}} extproc(*dclcase);
{{#each procedureSignatures.get.parameters}}
  {{name}} {{type}}{{#if isConst}} const{{/if}};
{{/each}}
end-pr;
{{/if}}
{{#if procedures.hasCreate}}
dcl-enum {{actionListName}} qualified;
  creation 'create';
end-enum;

dcl-pr {{procedureSignatures.isValid.name}} {{procedureSignatures.isValid.returnType}} extproc(*dclcase);
{{#each procedureSignatures.isValid.parameters}}
  {{name}} {{type}}{{#if isConst}} const{{/if}};
{{/each}}
end-pr;

dcl-pr {{procedureSignatures.create.name}} {{procedureSignatures.create.returnType}} extproc(*dclcase);
{{#each procedureSignatures.create.parameters}}
  {{name}} {{type}}{{#if isConst}} const{{/if}};
{{/each}}
end-pr;
{{/if}}
