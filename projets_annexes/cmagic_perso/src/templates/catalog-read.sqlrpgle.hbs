{{! Catalogue read module. CatalogSpec is adapted to this template by rpg-read.ts. }}
{{#*inline "failQuery"}}
    {{@root.procedures.rejectQuery}}(
      pErrors : 'sql' : '{{message}}');
    list_dispose(lItems);
    return *off;
{{/inline}}
// Generated from CatalogSpec with catalog-read.sqlrpgle.hbs. Do not edit.
ctl-opt nomain
        option(*nodebugio:*srcstmt:*nounref)
        alwnull(*usrctl)
        datfmt(*iso)
        bnddir('QC2LE':'CKOOL');
/include '{{readInterfaceSource}}'
/include 'sqlstates.rpginc'
/include 'llist/llist_h.rpgle'

exec sql set option commit = *none, datfmt = *iso, closqlcsr = *endmod;

dcl-proc {{procedures.rejectQuery}};
  dcl-pi *n;
    pErrors likeDS(GLOBAL_listError);
    pField varchar(32) const;
    pMessage varchar(256) const;
  end-pi;
  pErrors.listError(1).code = 'CAT0001';
  pErrors.listError(1).nomZone = pField;
  pErrors.listError(1).text = pMessage;
  pErrors.listError(1).textUser = pMessage;
end-proc;

{{#if procedures.hasMutation}}
dcl-proc {{procedures.rejectMutation}};
  dcl-pi *n;
    pErrors likeDS(GLOBAL_listError);
    pCode varchar(7) const;
    pField varchar(32) const;
    pMessage varchar(256) const;
  end-pi;
  pErrors.listError(1).code = pCode;
  pErrors.listError(1).nomZone = pField;
  pErrors.listError(1).text = pMessage;
  pErrors.listError(1).textUser = pMessage;
end-proc;
{{/if}}

{{#if procedures.hasList}}
dcl-proc {{procedureSignatures.getSupportedFields.name}} export;
  dcl-pi *n {{procedureSignatures.getSupportedFields.returnType}};
{{#each procedureSignatures.getSupportedFields.parameters}}
    {{name}} {{type}}{{#if isConst}} const{{/if}};
{{/each}}
  end-pi;
  dcl-s lIt int(10) inz(0);
  dcl-s ErrorHappened ind;

  clear pSupportedFields;
  clear pErrors;
{{#each supportedFields}}
  lIt += 1;
  pSupportedFields.supportedFields(lIt).name = '{{name}}';
  pSupportedFields.supportedFields(lIt).sqlField = '{{column}}';
  pSupportedFields.supportedFields(lIt).dataType = '{{cmagicDataType}}';
  pSupportedFields.supportedFields(lIt).maxLength = {{maxLength}};
  pSupportedFields.supportedFields(lIt).orderTri = lIt;
{{/each}}
  pSupportedFields.fieldsCount = lIt;
  sorta %subarr(pSupportedFields.supportedFields(*).orderTri
    : 1 : pSupportedFields.fieldsCount);
  return *on;

  on-exit ErrorHappened;
    if ErrorHappened;
      clear pSupportedFields;
      return *off;
    endif;
end-proc;

dcl-proc {{procedureSignatures.search.name}} export;
  dcl-pi *n {{procedureSignatures.search.returnType}};
{{#each procedureSignatures.search.parameters}}
    {{name}} {{type}}{{#if isConst}} const{{/if}};
{{/each}}
  end-pi;
  dcl-ds lErrors likeDS(GLOBAL_listError) inz;
  dcl-ds lRequestedContext likeDS(CMAGIC_context) inz;
  dcl-ds lContext likeDS(CMAGIC_context) inz;
  dcl-ds lSupportedFields likeDS(CMAGIC_supportedFields) inz;
  dcl-ds lRow likeDS({{entityName}}_item_t) inz;
  dcl-s lSelect varchar(5000) inz;
  dcl-s lSelCount like(lSelect) inz;
  dcl-s lWhere like(lSelect) inz;
  dcl-s lOrderBy like(lSelect) inz;
  dcl-s lItems pointer inz;
  dcl-s lCount like(CMAGIC_totalCount) inz(0);
  dcl-s ErrorHappened ind;

  clear pTotalCount;
  clear pItems;
  clear pErrors;
  lRequestedContext = pContext;
  if %trim(lRequestedContext.sort(1).field) = *blanks;
    lRequestedContext.sort(1).field = '{{defaultSortField}}';
    lRequestedContext.sort(1).order = '{{defaultSortOrder}}';
  endif;

  if not {{procedures.getSupportedFields}}(lSupportedFields : lErrors);
    pErrors = lErrors;
    return *off;
  endif;

  if not cmagic_sanitizeContext(lRequestedContext : lSupportedFields
    : lContext : lErrors);
    pErrors = lErrors;
    return *off;
  endif;

  if not cmagic_computeSqlClauses(lContext : lSupportedFields
    : lSelect : lWhere : lOrderBy : lErrors);
    pErrors = lErrors;
    return *off;
  endif;

  lSelect += ' FROM {{table}}';
  if lWhere <> *blanks;
    lSelect = %trim(lSelect) + ' ' + %trim(lWhere);
  endif;
  lSelCount = 'SELECT COUNT(*) FROM (' + %trim(lSelect)
    + ') CATALOG_COUNT';
  if lOrderBy <> *blanks;
    lSelect = %trim(lSelect) + ' ' + %trim(lOrderBy);
  endif;
  lSelect = %trim(lSelect)
    + ' LIMIT ' + %char(lContext.pagination.perPage)
    + ' OFFSET ' + %char(
      (lContext.pagination.numPage - 1)
      * lContext.pagination.perPage)
    + ' FOR READ ONLY OPTIMIZE FOR '
    + %char(lContext.pagination.perPage) + ' ROWS';

  lItems = list_create();
  exec sql prepare CATALOG_LIST_STATEMENT from :lSelect;
  if sqlState <> SQL_OK;
{{> failQuery message="Unable to prepare search query"}}
  endif;

  exec sql declare CATALOG_LIST cursor for CATALOG_LIST_STATEMENT;
  exec sql open CATALOG_LIST;
  if sqlState <> SQL_OK;
{{> failQuery message="Unable to open search cursor"}}
  endif;

  dow sqlState = SQL_OK;
    clear lRow;
    exec sql fetch next from CATALOG_LIST into :lRow;
    if sqlState = SQL_NOT_FOUND;
      leave;
    endif;
    if sqlState <> SQL_OK;
      exec sql close CATALOG_LIST;
  {{> failQuery message="Unable to fetch search row"}}
    endif;
    list_add(lItems : %addr(lRow) : %size(lRow));
  enddo;
  exec sql close CATALOG_LIST;

  exec sql prepare CATALOG_COUNT_STATEMENT from :lSelCount;
  if sqlState <> SQL_OK;
{{> failQuery message="Unable to prepare count query"}}
  endif;

  exec sql declare CATALOG_COUNT cursor for CATALOG_COUNT_STATEMENT;
  exec sql open CATALOG_COUNT;
  if sqlState <> SQL_OK;
{{> failQuery message="Unable to open count cursor"}}
  endif;
  exec sql fetch next from CATALOG_COUNT into :lCount;
  if sqlState <> SQL_OK and sqlState <> SQL_NOT_FOUND;
    exec sql close CATALOG_COUNT;
{{> failQuery message="Unable to fetch total count"}}
  endif;
  exec sql close CATALOG_COUNT;

  pItems = lItems;
  pTotalCount = lCount;
  return *on;

  on-exit ErrorHappened;
    exec sql close CATALOG_LIST;
    exec sql close CATALOG_COUNT;
    if ErrorHappened;
      if lItems <> *null;
        list_dispose(lItems);
      endif;
      return *off;
    endif;
end-proc;
{{/if}}{{#if procedures.hasGet}}
dcl-proc {{procedureSignatures.get.name}} export;
  dcl-pi *n {{procedureSignatures.get.returnType}};
{{#each procedureSignatures.get.parameters}}
    {{name}} {{type}}{{#if isConst}} const{{/if}};
{{/each}}
  end-pi;
  clear pDetail;
  clear pErrors;
  exec sql
    select
{{#each detailFields}}
      {{#if required}}{{column}}{{else}}COALESCE({{column}}, {{sqlDefault}}){{/if}}{{#unless @last}},{{/unless}}
{{/each}}
    into :pDetail
    FROM {{table}}
    WHERE {{id.column}} = :pId
    fetch first 1 row only;
  if sqlState = SQL_NOT_FOUND;
    {{procedures.rejectQuery}}(
      pErrors : 'id' : '{{entityDisplayName}} not found');
    return *off;
  endif;
  if sqlState <> SQL_OK;
    {{procedures.rejectQuery}}(
      pErrors : 'sql' : 'Unable to read {{entityDisplayName}}');
    return *off;
  endif;
  return *on;
end-proc;
{{/if}}
{{#if procedures.hasMutation}}
dcl-proc {{procedureSignatures.isValid.name}} export;
  dcl-pi *n {{procedureSignatures.isValid.returnType}};
{{#each procedureSignatures.isValid.parameters}}
    {{name}} {{type}}{{#if isConst}} const{{/if}};
{{/each}}
  end-pi;
  dcl-s lErrorIndex int(10) inz(0);
  dcl-ds lErrors likeDS(GLOBAL_listError) inz;
  dcl-s ErrorHappened ind;

  clear pErrors;
  select;
{{#if procedures.hasCreate}}
{{#if procedures.hasUpdate}}
    when pAction = {{actionListName}}.creation
      or pAction = {{actionListName}}.modification;
{{else}}
    when pAction = {{actionListName}}.creation;
{{/if}}
{{else}}
    when pAction = {{actionListName}}.modification;
{{/if}}
{{#each detailFields}}
{{#if requiredCondition}}
      if {{requiredCondition}};
        lErrorIndex += 1;
        pErrors.listError(lErrorIndex).code = 'CAT1001';
        pErrors.listError(lErrorIndex).nomZone = '{{name}}';
        pErrors.listError(lErrorIndex).text = '{{name}} is required';
        pErrors.listError(lErrorIndex).textUser =
          pErrors.listError(lErrorIndex).text;
      endif;
{{/if}}
{{#if domainCondition}}
      if {{domainCondition}};
        lErrorIndex += 1;
        pErrors.listError(lErrorIndex).code = 'CAT1004';
        pErrors.listError(lErrorIndex).nomZone = '{{name}}';
        pErrors.listError(lErrorIndex).text = '{{name}} has an invalid value';
        pErrors.listError(lErrorIndex).textUser =
          pErrors.listError(lErrorIndex).text;
      endif;
{{/if}}
{{/each}}
{{#if procedures.hasUpdate}}
      if pAction = {{actionListName}}.modification
        and pBeforeDetail.{{id.rpgName}} <> pAfterDetail.{{id.rpgName}};
        lErrorIndex += 1;
        pErrors.listError(lErrorIndex).code = 'CAT1005';
        pErrors.listError(lErrorIndex).nomZone = '{{id.name}}';
        pErrors.listError(lErrorIndex).text =
          '{{id.name}} cannot be changed';
        pErrors.listError(lErrorIndex).textUser =
          pErrors.listError(lErrorIndex).text;
      endif;
{{/if}}
    other;
      {{procedures.rejectMutation}}(
        pErrors : 'CAT1003' : 'action' : 'Unsupported mutation action');
      return *off;
  endsl;

  if lErrorIndex > 0;
    return *off;
  endif;
  if not {{procedures.isValidBusiness}}(
    pAction : pBeforeDetail : pAfterDetail : lErrors);
    pErrors = lErrors;
    return *off;
  endif;
  return *on;

  on-exit ErrorHappened;
    if ErrorHappened;
      {{procedures.rejectMutation}}(
        pErrors : 'RNX9001' : 'sql' :
        'Unexpected error while validating {{entityDisplayName}}');
      return *off;
    endif;
end-proc;
{{/if}}
{{#if procedures.hasCreate}}
dcl-proc {{procedureSignatures.create.name}} export;
  dcl-pi *n {{procedureSignatures.create.returnType}};
{{#each procedureSignatures.create.parameters}}
    {{name}} {{type}}{{#if isConst}} const{{/if}};
{{/each}}
  end-pi;
  dcl-ds lBeforeDetail likeDS({{entityName}}_detail_t) inz;
  dcl-ds lAfterDetail likeDS({{entityName}}_detail_t) inz;
  dcl-ds lErrors likeDS(GLOBAL_listError) inz;
  dcl-s ErrorHappened ind;

  clear pId;
  clear pErrors;
  lAfterDetail = pDetail;
  if not {{procedures.isValid}}({{actionListName}}.creation
    : lBeforeDetail : lAfterDetail : lErrors);
    pErrors = lErrors;
    return *off;
  endif;

  exec sql
    INSERT INTO {{table}}
    ({{#each detailFields}}{{column}}{{#unless @last}}, {{/unless}}{{/each}})
    VALUES
    ({{#each detailFields}}{{writeValue}}{{#unless @last}}, {{/unless}}{{/each}});
  select;
    when sqlState = '23505';
      {{procedures.rejectMutation}}(
        pErrors : 'CAT1002' : 'conflict' :
        '{{entityDisplayName}} already exists');
      return *off;
    when sqlState <> SQL_OK;
      {{procedures.rejectMutation}}(
        pErrors : sqlState : 'sql' :
        'Unable to create {{entityDisplayName}}');
      return *off;
  endsl;

  pId = pDetail.{{id.rpgName}};
  return *on;

  on-exit ErrorHappened;
    if ErrorHappened;
      {{procedures.rejectMutation}}(
        pErrors : 'RNX9001' : 'sql' :
        'Unexpected error while creating {{entityDisplayName}}');
      return *off;
    endif;
end-proc;
{{/if}}
{{#if procedures.hasUpdate}}
dcl-proc {{procedureSignatures.update.name}} export;
  dcl-pi *n {{procedureSignatures.update.returnType}};
{{#each procedureSignatures.update.parameters}}
    {{name}} {{type}}{{#if isConst}} const{{/if}};
{{/each}}
  end-pi;
  dcl-ds lBeforeDetail likeDS({{entityName}}_detail_t) inz;
  dcl-ds lAfterDetail likeDS({{entityName}}_detail_t) inz;
  dcl-ds lErrors likeDS(GLOBAL_listError) inz;
  dcl-s ErrorHappened ind;

  clear pErrors;
  if not {{procedures.get}}(pId : lBeforeDetail : lErrors);
    pErrors = lErrors;
    return *off;
  endif;

  lAfterDetail = pDetail;
  clear lErrors;
  if not {{procedures.isValid}}({{actionListName}}.modification
    : lBeforeDetail : lAfterDetail : lErrors);
    pErrors = lErrors;
    return *off;
  endif;

  exec sql
    UPDATE {{table}}
    SET
{{#each updateFields}}
      {{column}} = {{writeValue}}{{#unless @last}},{{/unless}}
{{/each}}
    WHERE {{id.column}} = :pId;
  select;
    when sqlState = '23505';
      {{procedures.rejectMutation}}(
        pErrors : 'CAT1002' : 'conflict' :
        '{{entityDisplayName}} update conflicts with existing data');
      return *off;
    when sqlState <> SQL_OK;
      {{procedures.rejectMutation}}(
        pErrors : sqlState : 'sql' :
        'Unable to update {{entityDisplayName}}');
      return *off;
  endsl;
  return *on;

  on-exit ErrorHappened;
    if ErrorHappened;
      {{procedures.rejectMutation}}(
        pErrors : 'RNX9001' : 'sql' :
        'Unexpected error while updating {{entityDisplayName}}');
      return *off;
    endif;
end-proc;
{{/if}}
{{#if procedures.hasMutation}}
// Ajoutez les regles metier specifiques dans cette procedure preservee.
// [CMAGIC:MANUAL_START]
dcl-proc {{procedures.isValidBusiness}};
  dcl-pi *n ind;
    pAction like(GLOBAL_codeAction) const;
    pBeforeDetail likeDS({{entityName}}_detail_t) const;
    pAfterDetail likeDS({{entityName}}_detail_t) const;
    pErrors likeDS(GLOBAL_listError);
  end-pi;
  clear pErrors;
  return *on;
end-proc;
// [CMAGIC:MANUAL_END]
{{/if}}
