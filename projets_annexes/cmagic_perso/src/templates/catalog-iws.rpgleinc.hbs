**free
{{! Public IBM Integrated Web Services interface generated from CatalogSpec. }}
/if defined({{includeGuard}})
/eof
/endif
/define {{includeGuard}}
/include '{{runtimeIncludes.cmagic}}'
/include '{{runtimeIncludes.global}}'
/include '{{runtimeIncludes.httpRest}}'

{{#if hasList}}
dcl-ds {{itemType}} qualified template;
{{#each itemFields}}
  {{name}} {{rpgType}};
{{/each}}
end-ds;

dcl-pr {{procedures.getListIws}} extproc(*dclcase);
  items_LENGTH int(10);
  items likeDS({{itemType}}) dim(HTTPREST_MAX_ITEMS);
  totalCount like(CMAGIC_totalCount);
  errors_LENGTH int(10);
  errors likeDS(errorItem) dim(HTTPREST_MAX_ERRORS);
  httpStatus like(HTTPREST_httpStatus);
  httpHeaders like(HTTPREST_httpHeader) dim(HTTPREST_nbHeaders);
end-pr;
{{/if}}
{{#if hasDetail}}
dcl-ds {{detailType}} qualified template;
{{#each detailFields}}
  {{name}} {{rpgType}};
{{/each}}
end-ds;
{{/if}}

{{#if hasGet}}
dcl-pr {{procedures.getOneIws}} extproc(*dclcase);
  id {{id.rpgType}} const;
  item likeDS({{detailType}});
  errors_LENGTH int(10);
  errors likeDS(errorItem) dim(HTTPREST_MAX_ERRORS);
  httpStatus like(HTTPREST_httpStatus);
  httpHeaders like(HTTPREST_httpHeader) dim(HTTPREST_nbHeaders);
end-pr;
{{/if}}
{{#if hasCreate}}
dcl-pr {{procedures.createIws}} extproc(*dclcase);
  input likeDS({{detailType}}) const;
  item likeDS({{detailType}});
  errors_LENGTH int(10);
  errors likeDS(errorItem) dim(HTTPREST_MAX_ERRORS);
  httpStatus like(HTTPREST_httpStatus);
  httpHeaders like(HTTPREST_httpHeader) dim(HTTPREST_nbHeaders);
end-pr;
{{/if}}
{{#if hasUpdate}}
dcl-pr {{procedures.updateIws}} extproc(*dclcase);
  id {{id.rpgType}} const;
  input likeDS({{detailType}}) const;
  item likeDS({{detailType}});
  errors_LENGTH int(10);
  errors likeDS(errorItem) dim(HTTPREST_MAX_ERRORS);
  httpStatus like(HTTPREST_httpStatus);
  httpHeaders like(HTTPREST_httpHeader) dim(HTTPREST_nbHeaders);
end-pr;
{{/if}}
{{#if hasDelete}}
dcl-pr {{procedures.deleteIws}} extproc(*dclcase);
  id {{id.rpgType}} const;
  errors_LENGTH int(10);
  errors likeDS(errorItem) dim(HTTPREST_MAX_ERRORS);
  httpStatus like(HTTPREST_httpStatus);
  httpHeaders like(HTTPREST_httpHeader) dim(HTTPREST_nbHeaders);
end-pr;
{{/if}}
