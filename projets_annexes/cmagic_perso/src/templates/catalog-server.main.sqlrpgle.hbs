**free
{{! ILEastic application server generated from CatalogServerSpec. }}
// Generated from CatalogServerSpec with catalog-server.main.sqlrpgle.hbs. Do not edit.
ctl-opt thread(*CONCURRENT)
        option(*nodebugio:*srcstmt:*nounref)
        alwnull(*usrctl)
        datfmt(*iso)
        main(main)
        bnddir('QC2LE':'ILEASTIC');

/include 'ileastic/ileastic.rpgle'
{{#each catalogs}}
/include '{{interfaceSource}}'
{{/each}}

dcl-proc main;
  dcl-ds config likeDS(IL_config) inz;

  config.port = {{port}};
  config.host = '{{host}}';

{{#each catalogs}}
  {{registerRoutes}}(config);
{{/each}}
  il_listen(config);
end-proc;
