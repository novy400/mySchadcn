exports[`SQL Generator - Sprint 01 > should generate proper constraints and indexes 1`] = `
"
-- ============================================
-- Table for entity: ConstraintTest
-- Generated by CMagic v1.0
-- ============================================
CREATE TABLE CONSTRAINTTESTP (
    ID INTEGER NOT NULL,
    UNIQUECODE VARCHAR(20) NOT NULL,
    EMAIL VARCHAR(100),
    OPTIONALFIELD VARCHAR(50),
    DEFAULTVALUE VARCHAR(30) DEFAULT 'test',
    BOOLEANFIELD CHAR(1) DEFAULT 'N',
    
    -- Technical metadata
    CREATED_AT TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    UPDATED_AT TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (ID),
    UNIQUE (UNIQUECODE),
    UNIQUE (EMAIL),
    CHECK (BOOLEANFIELD IN ('Y', 'N'))
);

-- Indexes for frequent searches
CREATE UNIQUE INDEX CONSTRAINTTESTP_UNIQUECODE_IDX ON CONSTRAINTTESTP (UNIQUECODE);
CREATE UNIQUE INDEX CONSTRAINTTESTP_EMAIL_IDX ON CONSTRAINTTESTP (EMAIL);

-- Comments
COMMENT ON TABLE CONSTRAINTTESTP IS 'Table for ConstraintTest - Generated by CMagic';
COMMENT ON COLUMN CONSTRAINTTESTP.ID IS 'id field';
COMMENT ON COLUMN CONSTRAINTTESTP.UNIQUECODE IS 'uniqueCode field';
COMMENT ON COLUMN CONSTRAINTTESTP.EMAIL IS 'email field';
COMMENT ON COLUMN CONSTRAINTTESTP.OPTIONALFIELD IS 'optionalField field';
COMMENT ON COLUMN CONSTRAINTTESTP.DEFAULTVALUE IS 'defaultValue field';
COMMENT ON COLUMN CONSTRAINTTESTP.BOOLEANFIELD IS 'booleanField field';


