"
-- ============================================
-- Table for entity: Customer
-- Generated by CMagic v1.0
-- ============================================
CREATE TABLE CUSTOMERP (
    ID INTEGER NOT NULL,
    CODE VARCHAR(10) NOT NULL,
    NAME VARCHAR(80) NOT NULL,
    ADDRESS VARCHAR(256),
    PHONE VARCHAR(20),
    EMAIL VARCHAR(100),
    STATUS VARCHAR(256) DEFAULT 'ACTIVE',
    CREATIONDATE DATE,
    CREDITLIMIT DECIMAL(15,2) DEFAULT 0,
    ISVIP CHAR(1) DEFAULT 'N',
    
    -- Technical metadata
    CREATED_AT TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    UPDATED_AT TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (ID),
    UNIQUE (CODE),
    CHECK (ISVIP IN ('Y', 'N'))
);

-- Indexes for frequent searches
CREATE UNIQUE INDEX CUSTOMERP_CODE_IDX ON CUSTOMERP (CODE);

-- Comments
