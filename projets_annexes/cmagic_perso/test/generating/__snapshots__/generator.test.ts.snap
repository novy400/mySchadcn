"
-- ============================================
-- Table for entity: Customer
-- Generated by CMagic v1.0
-- ============================================
CREATE TABLE CUSTOMERP (
    ID INTEGER NOT NULL,
    CODE VARCHAR(10) NOT NULL,
    NAME VARCHAR(80) NOT NULL,
    ADDRESS VARCHAR(256),
    STATUS VARCHAR(256) DEFAULT 'ACTIVE',
    
    -- Technical metadata
    CREATED_AT TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    UPDATED_AT TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (ID),
    UNIQUE (CODE)
);

-- Indexes for frequent searches
CREATE UNIQUE INDEX CUSTOMERP_CODE_IDX ON CUSTOMERP (CODE);

-- Comments
COMMENT ON TABLE CUSTOMERP IS 'Table for Customer - Generated by CMagic';
COMMENT ON COLUMN CUSTOMERP.ID IS 'id field';
COMMENT ON COLUMN CUSTOMERP.CODE IS 'code field';
COMMENT ON COLUMN CUSTOMERP.NAME IS 'name field';
COMMENT ON COLUMN CUSTOMERP.ADDRESS IS 'address field';
COMMENT ON COLUMN CUSTOMERP.STATUS IS 'status field';

-- ============================================
-- Table for entity: Product
-- Generated by CMagic v1.0
-- ============================================
CREATE TABLE PRODUCTP (
    ID INTEGER NOT NULL,
    CODE VARCHAR(20) NOT NULL,
    NAME VARCHAR(100) NOT NULL,
    PRICE DECIMAL(10,2),
    ACTIVE CHAR(1) DEFAULT 'Y',
    
    -- Technical metadata
    CREATED_AT TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    UPDATED_AT TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (ID),
    UNIQUE (CODE),
    CHECK (ACTIVE IN ('Y', 'N'))
);

-- Indexes for frequent searches
CREATE UNIQUE INDEX PRODUCTP_CODE_IDX ON PRODUCTP (CODE);

-- Comments
COMMENT ON TABLE PRODUCTP IS 'Table for Product - Generated by CMagic';
COMMENT ON COLUMN PRODUCTP.ID IS 'id field';
COMMENT ON COLUMN PRODUCTP.CODE IS 'code field';
COMMENT ON COLUMN PRODUCTP.NAME IS 'name field';
COMMENT ON COLUMN PRODUCTP.PRICE IS 'price field';
COMMENT ON COLUMN PRODUCTP.ACTIVE IS 'active field';

-- ============================================
-- Table for entity: Order
-- Generated by CMagic v1.0
-- ============================================
CREATE TABLE ORDERP (
    ID INTEGER NOT NULL,
    ORDERNUMBER VARCHAR(20) NOT NULL,
    CUSTOMERID INTEGER NOT NULL,
    PRODUCTID INTEGER NOT NULL,
    PRIORITY VARCHAR(256) DEFAULT 'MEDIUM',
    ORDERDATE DATE NOT NULL,
    DELIVERYDATE DATE,
    AMOUNT DECIMAL(15,2) DEFAULT 0,
    NOTES VARCHAR(500),
    
    -- Technical metadata
    CREATED_AT TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    UPDATED_AT TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (ID),
    UNIQUE (ORDERNUMBER)
);

-- Indexes for frequent searches
CREATE UNIQUE INDEX ORDERP_ORDERNUMBER_IDX ON ORDERP (ORDERNUMBER);

-- Comments
COMMENT ON TABLE ORDERP IS 'Table for Order - Generated by CMagic';
COMMENT ON COLUMN ORDERP.ID IS 'id field';
COMMENT ON COLUMN ORDERP.ORDERNUMBER IS 'orderNumber field';
COMMENT ON COLUMN ORDERP.CUSTOMERID IS 'customerId field';
COMMENT ON COLUMN ORDERP.PRODUCTID IS 'productId field';
COMMENT ON COLUMN ORDERP.PRIORITY IS 'priority field';
COMMENT ON COLUMN ORDERP.ORDERDATE IS 'orderDate field';
COMMENT ON COLUMN ORDERP.DELIVERYDATE IS 'deliveryDate field';
COMMENT ON COLUMN ORDERP.AMOUNT IS 'amount field';
COMMENT ON COLUMN ORDERP.NOTES IS 'notes field';


-- ============================================
-- Foreign Key Constraints
-- ============================================


ALTER TABLE ORDERP ADD CONSTRAINT FK_ORDER_CUSTOMERID FOREIGN KEY (CUSTOMERID) REFERENCES CUSTOMERP (ID);
CREATE INDEX ORDERP_CUSTOMERID_IDX ON ORDERP (CUSTOMERID);
ALTER TABLE ORDERP ADD CONSTRAINT FK_ORDER_PRODUCTID FOREIGN KEY (PRODUCTID) REFERENCES PRODUCTP (ID);
CREATE INDEX ORDERP_PRODUCTID_IDX ON ORDERP (PRODUCTID);

"
`;

