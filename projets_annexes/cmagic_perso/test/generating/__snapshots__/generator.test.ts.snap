-- ============================================
-- Table for entity: FullConstraints
-- Generated by CMagic v1.0
-- ============================================
CREATE TABLE FULLCONSTRAINTSP (
    ID INTEGER NOT NULL,
    UNIQUEREQUIRED VARCHAR(50) NOT NULL,
    UNIQUEOPTIONAL VARCHAR(50),
    DEFAULTREQUIRED VARCHAR(30) NOT NULL DEFAULT 'test',
    DEFAULTOPTIONAL VARCHAR(30) DEFAULT 'optional',
    BOOLEANDEFAULT CHAR(1) DEFAULT 'Y',
    DECIMALDEFAULT DECIMAL(10,2) DEFAULT 99.99,
    
    -- Technical metadata
    CREATED_AT TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    UPDATED_AT TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (ID),
    UNIQUE (UNIQUEREQUIRED),
    UNIQUE (UNIQUEOPTIONAL),
    CHECK (BOOLEANDEFAULT IN ('Y', 'N'))
);

-- Indexes for frequent searches
CREATE UNIQUE INDEX FULLCONSTRAINTSP_UNIQUEREQUIRED_IDX ON FULLCONSTRAINTSP (UNIQUEREQUIRED);
CREATE UNIQUE INDEX FULLCONSTRAINTSP_UNIQUEOPTIONAL_IDX ON FULLCONSTRAINTSP (UNIQUEOPTIONAL);

-- Comments
COMMENT ON TABLE FULLCONSTRAINTSP IS 'Table for FullConstraints - Generated by CMagic';
COMMENT ON COLUMN FULLCONSTRAINTSP.ID IS 'id field';
COMMENT ON COLUMN FULLCONSTRAINTSP.UNIQUEREQUIRED IS 'uniqueRequired field';
COMMENT ON COLUMN FULLCONSTRAINTSP.UNIQUEOPTIONAL IS 'uniqueOptional field';
COMMENT ON COLUMN FULLCONSTRAINTSP.DEFAULTREQUIRED IS 'defaultRequired field';
COMMENT ON COLUMN FULLCONSTRAINTSP.DEFAULTOPTIONAL IS 'defaultOptional field';
COMMENT ON COLUMN FULLCONSTRAINTSP.BOOLEANDEFAULT IS 'booleanDefault field';
COMMENT ON COLUMN FULLCONSTRAINTSP.DECIMALDEFAULT IS 'decimalDefault field';


-- ============================================
-- Foreign Key Constraints
