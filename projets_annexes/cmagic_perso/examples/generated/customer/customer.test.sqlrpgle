// Test création Customer
dcl-proc test_customer_create_success export;
    dcl-pi *N; 
    end-pi;
    dcl-s ErrorHappened ind;
    dcl-ds lDetail likeds(customer_detail_t) inz;
    dcl-ds lId likeds(customer_id_t) inz;
    dcl-ds lErrors likeds(GLOBAL_listError) inz;
    dcl-s lOK ind;
    
    // [CMAGIC:MANUAL_START:test_customer_create_setup]
    // Préparer les données de test pour création
    // [CMAGIC:MANUAL_END:test_customer_create_setup]
    
    // Test création
    lOK = customer_create(lDetail : lId : lErrors);
    
    // Vérifications
    assert(lOK : 'Creation should succeed');
    assert(lId.id > 0 : 'ID should be generated');
    
    // [CMAGIC:MANUAL_START:test_customer_create_cleanup]
    // Cleanup spécifique au test
    // [CMAGIC:MANUAL_END:test_customer_create_cleanup]
    
  on-exit ErrorHappened;
    if ErrorHappened;
      fail('Unexpected error in customer_create test');
    endif;
end-proc;

dcl-proc test_customer_create_validation_error export;
    dcl-pi *N; 
    end-pi;
    dcl-s ErrorHappened ind;
    dcl-ds lDetail likeds(customer_detail_t) inz;
    dcl-ds lId likeds(customer_id_t) inz;
    dcl-ds lErrors likeds(GLOBAL_listError) inz;
    dcl-s lOK ind;
    
    // [CMAGIC:MANUAL_START:test_customer_create_invalid_setup]
    // Préparer des données invalides pour test validation
    // [CMAGIC:MANUAL_END:test_customer_create_invalid_setup]
    
    // Test création avec données invalides
    lOK = customer_create(lDetail : lId : lErrors);
    
    // Vérifications
    assert(not lOK : 'Creation should fail with invalid data');
    assert(lErrors.count > 0 : 'Should have validation errors');
    
  on-exit ErrorHappened;
    if ErrorHappened;
      fail('Unexpected error in customer_create validation test');
    endif;
end-proc;





// Test récupération Customer par ID
dcl-proc test_customer_getByID_success export;
    dcl-pi *N; 
    end-pi;
    dcl-s ErrorHappened ind;
    dcl-ds lId likeds(customer_id_t) inz;
    dcl-ds lDetail likeds(customer_detail_t) inz;
    dcl-ds lErrors likeds(GLOBAL_listError) inz;
    dcl-s lOK ind;
    
    // [CMAGIC:MANUAL_START:test_customer_getByID_setup]
    // Préparer un ID existant pour le test
    // [CMAGIC:MANUAL_END:test_customer_getByID_setup]
    
    // Test récupération
    lOK = customer_getByID(lId : lDetail : lErrors);
    
    // Vérifications
    assert(lOK : 'GetByID should succeed');
    assert(lDetail.detail.id = lId.id : 'Retrieved ID should match');
    
  on-exit ErrorHappened;
    if ErrorHappened;
      fail('Unexpected error in customer_getByID test');
    endif;
end-proc;

dcl-proc test_customer_getByID_not_found export;
    dcl-pi *N; 
    end-pi;
    dcl-s ErrorHappened ind;
    dcl-ds lId likeds(customer_id_t) inz;
    dcl-ds lDetail likeds(customer_detail_t) inz;
    dcl-ds lErrors likeds(GLOBAL_listError) inz;
    dcl-s lOK ind;
    
    // Setup avec un ID inexistant
    lId.id = -999;
    
    // Test récupération
    lOK = customer_getByID(lId : lDetail : lErrors);
    
    // Vérifications
    assert(not lOK : 'GetByID should fail for non-existent ID');
    
  on-exit ErrorHappened;
    if ErrorHappened;
      fail('Unexpected error in customer_getByID not found test');
    endif;
end-proc;





