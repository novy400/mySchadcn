// Test recherche Customer
dcl-proc test_customer_search_firstPage export;
    dcl-pi *N; 
    end-pi;
    dcl-s ErrorHappened ind;
    dcl-ds lContext likeDS(CMAGIC_context) inz;
    dcl-s lTotalCount like(CMAGIC_totalCount);
    dcl-ds lErrors likeDS(GLOBAL_listError) inz;
    dcl-s list pointer;
    dcl-s lOK ind;
    dcl-s lTotalCountExpected like(CMAGIC_totalCount) inz(0);
    dcl-s lCount int(10);
    
    // [CMAGIC:MANUAL_START:test_customer_search_setup]
    // Préparer les critères de recherche et données attendues
    lContext.pageSize = 10;
    lContext.pageNumber = 1;
    // [CMAGIC:MANUAL_END:test_customer_search_setup]
    
    // Test recherche
    lOK = customer_search(lContext : lTotalCount : list : lErrors);
    
    // Vérifications
    assert(lOK : 'Search should succeed');
    assert(lTotalCount >= 0 : 'Total count should be >= 0');
    
  on-exit ErrorHappened;
    if ErrorHappened;
      fail('Unexpected error in customer_search test');
    endif;
end-proc;

