{
  "openapi": "3.1.0",
  "info": {
    "title": "Fournis catalogue API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/fournisseurs": {
      "get": {
        "operationId": "listFournis",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "perPage",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "nom"
              ]
            }
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ASC",
                "DESC"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "x-cmagic-operators": [
              "like"
            ]
          },
          {
            "name": "ville",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 80
            },
            "x-cmagic-operators": [
              "eq",
              "like"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Liste paginée de fournisseurs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Fournis"
                      }
                    },
                    "total": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "data",
                    "total"
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createFournis",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Fournis"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Fournis cree",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Fournis"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Donnees Fournis invalides"
          },
          "409": {
            "description": "Fournis existe deja"
          },
          "500": {
            "description": "Erreur technique pendant la creation de Fournis"
          }
        }
      }
    },
    "/api/fournisseurs/{id}": {
      "get": {
        "operationId": "getFournis",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Fournis trouvé",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Fournis"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Fournis inconnu"
          }
        }
      },
      "put": {
        "operationId": "updateFournis",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 10
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Fournis"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Fournis modifie",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Fournis"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Donnees Fournis invalides"
          },
          "404": {
            "description": "Fournis inconnu"
          },
          "409": {
            "description": "Conflit pendant la modification de Fournis"
          },
          "500": {
            "description": "Erreur technique pendant la modification de Fournis"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Fournis": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 10
          },
          "nom": {
            "type": "string",
            "maxLength": 100
          },
          "adresse": {
            "type": "string",
            "maxLength": 160
          },
          "ville": {
            "type": "string",
            "maxLength": 80
          },
          "telephone": {
            "type": "string",
            "maxLength": 20
          },
          "email": {
            "type": "string",
            "maxLength": 254
          }
        },
        "required": [
          "id",
          "nom"
        ]
      }
    }
  }
}
