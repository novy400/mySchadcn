     A          R AUDIT
     A                                      WINDOW(5 5 10 70)
     A                                      WDWBORDER((*DSPATR HI RI) (*CHAR ' -
     A                                             '))
     A                                  2  2'AUDIT'
     A                                      COLOR(PNK)
     A                                  3 13'Le                       '
     A                                      DSPATR(UL)
     A                                      COLOR(WHT)
     A                                  3 40'Qui      '
     A                                      DSPATR(UL)
     A                                      COLOR(WHT)
     A                                  3 52'Par      '
     A                                      DSPATR(UL)
     A                                      COLOR(WHT)
     A                                  4  2'Statut'
     A                                      COLOR(WHT)
     A                                  9 29'F12=Annuler'
     A                                      COLOR(BLU)
     A          R CONFIRM
     A                                      WINDOW(5 10 10 40)
     A                                      WDWBORDER((*DSPATR HI RI) (*CHAR ' -
     A                                             '))
     A                                  2  2'CONFIRMATION'
     A                                      COLOR(PNK)
     A            CONF1         38   O  4  2COLOR(RED)
     A            CONF2         38   O  5  2COLOR(RED)
     A            CONF3         38   O  6  2COLOR(RED)
     A            CONF4         38   O  7  2COLOR(RED)
     A                                  9  2'F9=CONFIRMER'
     A                                      COLOR(BLU)
     A                                      DSPATR(RI)
     A                                  9 29'F12=Annuler'
