CREATE or REPLACE TABLE CONTFIGDAT ( 
  id INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  codeEtablissement FOR COLUMN codetb char(3) NOT NULL DEFAULT '',
  numeroContrat FOR COLUMN numctr  NUMERIC(9, 0) NOT NULL DEFAULT 0,
	dateFigementContrat FOR COLUMN datfig DATE NOT NULL DEFAULT CURRENT_DATE, 
	motifFigement FOR COLUMN motif VARCHAR(512) DEFAULT NULL,
  -- Zones d'audit.
    utilisateurCreation FOR COLUMN
    USRCRT  VARCHAR(128) WITH DEFAULT USER IMPLICITLY HIDDEN,
    dateHeureCreation FOR COLUMN
    DTHCRT  TIMESTAMP NOT NULL
            WITH DEFAULT CURRENT_TIMESTAMP IMPLICITLY HIDDEN,
    utilisateurModification FOR COLUMN
    USRMOD  VARCHAR(255)
            GENERATED ALWAYS AS (CURRENT CLIENT_USERID) IMPLICITLY HIDDEN,
    dateHeureModification FOR COLUMN
    DTHMOD TIMESTAMP(12) NOT NULL
            GENERATED ALWAYS AS ROW BEGIN IMPLICITLY HIDDEN,
    sessionModification FOR COLUMN
    SESMOD  VARCHAR(128)
            GENERATED ALWAYS AS (SESSION_USER) IMPLICITLY HIDDEN,
    pgmModification FOR COLUMN
    PGMMOD  VARCHAR(255)
           GENERATED ALWAYS AS (CURRENT CLIENT_PROGRAMID) IMPLICITLY HIDDEN,
    ecranModification FOR COLUMN
    WRKSTN  VARCHAR(255)
           GENERATED ALWAYS AS (CURRENT CLIENT_WRKSTNNAME) IMPLICITLY HIDDEN,
    serviceModification FOR COLUMN
    SERVNM  VARCHAR(18)
            GENERATED ALWAYS AS (CURRENT SERVER) IMPLICITLY HIDDEN,
    travailModification FOR COLUMN
    JOBNM   VARCHAR(28)
            GENERATED ALWAYS AS (QSYS2.JOB_NAME) IMPLICITLY HIDDEN,
  -- zones temporelles standard
    finModification FOR COLUMN FINMOD
        TIMESTAMP(12) 
        GENERATED ALWAYS AS ROW END NOT NULL
        IMPLICITLY HIDDEN,
        
    transactionId FOR COLUMN TRANID
        TIMESTAMP(12) 
        GENERATED ALWAYS AS TRANSACTION START ID
        IMPLICITLY HIDDEN,
    
    PERIOD SYSTEM_TIME (DTHMOD, FINMOD)            
  ) RCDFMT CONTFIGDAF;   


LABEL ON TABLE CONTFIGDAT IS 'Table des dates de figement des contrats.';

LABEL ON COLUMN CONTFIGDAT
(ID       IS 'ID UNIQUE' ,
 CODETB   IS 'CODE ETABLISSEMENT' ,
 NUMCTR  IS 'NUMÉRO CONTRAT' ,
 DATFIG   IS 'DATE DE FIGEMENT' ,
 MOTIF    IS 'MOTIF DE FIGEMENT' ,
 USRCRT   IS 'USER DE CRÉATION' ,
 DTHCRT   IS 'DATE HEURE DE CRÉATION' ,
 USRMOD   IS 'USER DE MODIFICATION',
 DTHMOD   IS 'DATE HEURE DE MODIFICATION',
 SESMOD   IS 'SESSION DE MODIFICATION',
 PGMMOD   IS 'PROGRAMME DE MODIFICATION',
 WRKSTN   IS 'STATION DE MODIFICATION',
 SERVNM   IS 'SERVEUR DE MODIFICATION',
 JOBNM    IS 'TRAVAIL DE MODIFICATION',
 FINMOD   IS 'DATE HEURE DE FIN DE VALIDITÉ',
 TRANID   IS 'ID DE TRANSACTION'
 );

LABEL ON COLUMN CONTFIGDAT
(ID       TEXT IS 'ID UNIQUE' ,
 CODETB   TEXT IS 'CODE ETABLISSEMENT' ,
 NUMCTR  TEXT IS 'NUMÉRO CONTRAT' ,
 DATFIG   TEXT IS 'DATE DE FIGEMENT' ,
 MOTIF    TEXT IS 'MOTIF DE FIGEMENT' ,
 USRCRT   TEXT IS 'USER DE CRÉATION' ,
 DTHCRT   TEXT IS 'DATE HEURE DE CRÉATION' ,
 USRMOD   TEXT IS 'USER DE MODIFICATION',
 DTHMOD   TEXT IS 'DATE HEURE DE MODIFICATION',
 SESMOD   TEXT IS 'SESSION DE MODIFICATION',
 PGMMOD   TEXT IS 'PROGRAMME DE MODIFICATION',
 WRKSTN   TEXT IS 'STATION DE MODIFICATION',
 SERVNM   TEXT IS 'SERVEUR DE MODIFICATION',
 JOBNM    TEXT IS 'TRAVAIL DE MODIFICATION',
 FINMOD   TEXT IS 'DATE HEURE DE FIN DE VALIDITÉ',
 TRANID   TEXT IS 'ID DE TRANSACTION'
 );

 ALTER TABLE CONTFIGDAT
ADD CONSTRAINT CONTFIGDAT_UNQ UNIQUE (codeEtablissement, numeroContrat);

