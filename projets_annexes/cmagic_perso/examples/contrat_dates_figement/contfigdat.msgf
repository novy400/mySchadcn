DLTMSGF MSGF(&O/&N)     
CRTMSGF MSGF(&O/&N)     
ADDMSGD MSGID(STD0001) MSGF(&O/&N) +
   MSG('Zone obligatoire.') 
ADDMSGD MSGID(STD0002) MSGF(&O/&N) +
   MSG('Zone invalide.') 
ADDMSGD MSGID(STD0003) MSGF(&O/&N) +
   MSG('Action inconnue.') 
ADDMSGD MSGID(STD0004) MSGF(&O/&N) +
   MSG('Mise à jour impossible.') 
ADDMSGD MSGID(STD0005) MSGF(&O/&N) +
   MSG('Recherche impossible.') 
ADDMSGD MSGID(CFD0001) MSGF(&O/&N) +
  MSG('Date de figement Contrat non trouvée.')
ADDMSGD MSGID(CFD0002) MSGF(&O/&N) +
  MSG('Etablissement invalide.')
ADDMSGD MSGID(CFD0003) MSGF(&O/&N) +
   MSG('Contrat invalide.') 
ADDMSGD MSGID(CFD0004) MSGF(&O/&N) +
   MSG('Date figement supérieure à la date d''écheance.') 
                        