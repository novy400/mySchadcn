entity Fournis resource "fournisseurs" table "FOURNIS" iwsObject "FOURIWS" {
    id: String(10) column "ID" key required searchable,
    nom: String(100) column "NOM" required searchable sortable,
    adresse: String(160) column "ADRESSE" searchable,
    ville: String(80) column "VILLE" searchable filter(EQ, LIKE),
    telephone: String(20) column "TELEPHONE" searchable,
    email: String(254) column "EMAIL" searchable
}

view list for Fournis {
    id, nom, adresse, ville, telephone, email
}

operations for Fournis {
    LIST,
    GET,
    CREATE,
    UPDATE
}
