 DLTMSGF MSGF(&O/&N)     
CRTMSGF MSGF(&O/&N)     
ADDMSGD MSGID(EMP0001) MSGF(&O/&N) +
  MSG('Prénom obligatoire.')
ADDMSGD MSGID(EMP0002) MSGF(&O/&N) +
   MSG('Nom obligatoire.') 
ADDMSGD MSGID(EMP0003) MSGF(&O/&N) +
   MSG('Genre invalide (M)asculin ou (F)éminin.') 
   ADDMSGD MSGID(EMP0004) MSGF(&O/&N) +
   MSG('Service obligatoire.')   
   ADDMSGD MSGID(EMP0005) MSGF(&O/&N) +
   MSG('Salaire doit être positif.') 
   ADDMSGD MSGID(EMP0006) MSGF(&O/&N) +
   MSG('Date doit être antérieure à aujourd''hui.')       
   ADDMSGD MSGID(EMP0007) MSGF(&O/&N) +
   MSG('Date d''embauche ne peut être future.')       
   ADDMSGD MSGID(EMP0008) MSGF(&O/&N) +
   MSG('ID employé obligatoire pour suppression.')       
   ADDMSGD MSGID(EMP0009) MSGF(&O/&N) +
   MSG('ID employé obligatoire pour consultation.')        
   ADDMSGD MSGID(EMP0010) MSGF(&O/&N) +
   MSG('Action inconnue.')                         