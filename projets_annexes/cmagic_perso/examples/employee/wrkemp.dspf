     A            CONF1         38   O  4  2COLOR(RED)
     A            CONF2         38   O  5  2COLOR(RED)
     A            CONF3         38   O  6  2COLOR(RED)
     A            CONF4         38   O  7  2COLOR(RED)
     A                                  9  2'F9=CONFIRMER'
     A                                      COLOR(BLU)
     A                                      DSPATR(RI)
