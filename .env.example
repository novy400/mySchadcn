# URL publique de la ressource IWS Service. Aucun secret ne doit être placé ici.
VITE_IBM_I_API_URL=/web/services/SERVIWS3

# URL publique de la ressource IWS Fournisseurs. Aucun secret ne doit être placé ici.
VITE_IBM_I_FOURNISSEURS_API_URL=/web/services/FOURIWS1

# Cible serveur du proxy Vite local. Cette variable n'est pas exposee au bundle client.
IBM_I_DEV_PROXY_TARGET=http://ibmi-host.example:10074
