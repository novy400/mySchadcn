<pcml restUriPathTemplate="/" version="7.0">
    <struct name="service_item_iws_t">
        <data length="3" name="id" type="varchar" usage="inherit"/>
        <data length="36" name="nom" type="varchar" usage="inherit"/>
        <data length="6" name="idManageur" type="varchar" usage="inherit"/>
        <data length="3" name="idServiceAdmin" type="varchar" usage="inherit"/>
        <data length="16" name="site" type="varchar" usage="inherit"/>
    </struct>
    <struct name="errorItem">
        <data length="32" name="nomZone" type="char" usage="inherit"/>
        <data length="7" name="code" type="char" usage="inherit"/>
        <data length="256" name="valeur" type="varchar" usage="inherit"/>
        <data length="256" name="text" type="varchar" usage="inherit"/>
        <data length="256" name="textUser" type="varchar" usage="inherit"/>
    </struct>
    <struct name="service_detail_iws_t">
        <data length="3" name="id" type="varchar" usage="inherit"/>
        <data length="36" name="nom" type="varchar" usage="inherit"/>
        <data length="6" name="idManageur" type="varchar" usage="inherit"/>
        <data length="3" name="idServiceAdmin" type="varchar" usage="inherit"/>
        <data length="16" name="site" type="varchar" usage="inherit"/>
    </struct>
    <program entrypoint="service_getone_iws" errormessage="" httpheaders="*NONE" httpstatusonfailure="500"
        httpstatusonsuccess="200" inputWrapperIdentifier="service_getone_iwsInput" name="service_getone_iws"
        outputWrapperIdentifier="service_getone_iwsResult" parseorder="errors_LENGTH item errors httpStatus httpHeaders"
        path="/QSYS.LIB/TESTBIN.LIB/SERVIWS.SRVPGM" restConsumes="*/*" restHttpRequestMethod="GET"
        restOutErrorParam="*ALL" restOutHeadersParam="httpHeaders" restOutResponseCodeParam="httpStatus"
        restProduces="application/json" restUriPathTemplate="/{id}" threadsafe="false" trimmode="*TRAILING"
        wrapInputParams="false" wrapOutputParam="true">
        <data length="3" name="id" restInPathParam="id" type="varchar" usage="input"/>
        <data name="item" struct="service_detail_iws_t" type="struct" usage="output"/>
        <data init="10" length="4" name="errors_LENGTH" precision="31" transient="true" type="int" usage="output"/>
        <data count="errors_LENGTH" name="errors" struct="errorItem" type="struct" usage="output"/>
        <data length="4" name="httpStatus" precision="31" type="int" usage="output"/>
        <data count="10" length="100" name="httpHeaders" type="char" usage="output"/>
    </program>
    <program entrypoint="service_update_iws" errormessage="" httpheaders="*NONE" httpstatusonfailure="500"
        httpstatusonsuccess="200" inputWrapperIdentifier="service_update_iwsInput" name="service_update_iws"
        outputWrapperIdentifier="service_update_iwsResult" parseorder="errors_LENGTH item errors httpStatus httpHeaders"
        path="/QSYS.LIB/TESTBIN.LIB/SERVIWS.SRVPGM" restConsumes="application/json" restHttpRequestMethod="PUT"
        restOutErrorParam="*ALL" restOutHeadersParam="httpHeaders" restOutResponseCodeParam="httpStatus"
        restProduces="application/json" restUriPathTemplate="/{id}" threadsafe="false" trimmode="*TRAILING"
        wrapInputParams="false" wrapOutputParam="true">
        <data length="3" name="id" restInPathParam="id" type="varchar" usage="input"/>
        <data name="input" struct="service_detail_iws_t" type="struct" usage="input"/>
        <data name="item" struct="service_detail_iws_t" type="struct" usage="output"/>
        <data init="10" length="4" name="errors_LENGTH" precision="31" transient="true" type="int" usage="output"/>
        <data count="errors_LENGTH" name="errors" struct="errorItem" type="struct" usage="output"/>
        <data length="4" name="httpStatus" precision="31" type="int" usage="output"/>
        <data count="10" length="100" name="httpHeaders" type="char" usage="output"/>
    </program>
    <program entrypoint="service_create_iws" errormessage="" httpheaders="*NONE" httpstatusonfailure="500"
        httpstatusonsuccess="200" inputWrapperIdentifier="service_create_iwsInput" name="service_create_iws"
        outputWrapperIdentifier="service_create_iwsResult" parseorder="errors_LENGTH item errors httpStatus httpHeaders"
        path="/QSYS.LIB/TESTBIN.LIB/SERVIWS.SRVPGM" restConsumes="application/json" restHttpRequestMethod="POST"
        restOutErrorParam="*ALL" restOutHeadersParam="httpHeaders" restOutResponseCodeParam="httpStatus"
        restProduces="application/json" threadsafe="false" trimmode="*TRAILING" wrapInputParams="false" wrapOutputParam="true">
        <data name="input" struct="service_detail_iws_t" type="struct" usage="input"/>
        <data name="item" struct="service_detail_iws_t" type="struct" usage="output"/>
        <data init="10" length="4" name="errors_LENGTH" precision="31" transient="true" type="int" usage="output"/>
        <data count="errors_LENGTH" name="errors" struct="errorItem" type="struct" usage="output"/>
        <data length="4" name="httpStatus" precision="31" type="int" usage="output"/>
        <data count="10" length="100" name="httpHeaders" type="char" usage="output"/>
    </program>
    <program entrypoint="service_getlist_iws" errormessage="" httpheaders="*NONE" httpstatusonfailure="500"
        httpstatusonsuccess="200" inputWrapperIdentifier="service_getlist_iwsInput" name="service_getlist_iws"
        outputWrapperIdentifier="service_getlist_iwsResult"
        parseorder="errors_LENGTH items_LENGTH items totalCount errors httpStatus httpHeaders"
        path="/QSYS.LIB/TESTBIN.LIB/SERVIWS.SRVPGM" restConsumes="*/*" restHttpRequestMethod="GET"
        restOutErrorParam="*ALL" restOutHeadersParam="httpHeaders" restOutResponseCodeParam="httpStatus"
        restProduces="application/json" threadsafe="false" trimmode="*TRAILING" wrapInputParams="false" wrapOutputParam="true">
        <data init="100" length="4" name="items_LENGTH" precision="31" transient="true" type="int" usage="output"/>
        <data count="items_LENGTH" name="items" struct="service_item_iws_t" type="struct" usage="output"/>
        <data length="4" name="totalCount" precision="31" type="int" usage="output"/>
        <data init="10" length="4" name="errors_LENGTH" precision="31" transient="true" type="int" usage="output"/>
        <data count="errors_LENGTH" name="errors" struct="errorItem" type="struct" usage="output"/>
        <data length="4" name="httpStatus" precision="31" type="int" usage="output"/>
        <data count="10" length="100" name="httpHeaders" type="char" usage="output"/>
    </program>
</pcml>
